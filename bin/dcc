#!/usr/bin/env bash
#
# dcc – docker-claude-code
# Claude Code with full permissions inside an isolated Docker container.
#
set -euo pipefail

DCC_VERSION="0.1.0"
BASE_IMAGE="${DCC_BASE_IMAGE:-dcc-base:latest}"
REGISTRY="${XDG_CONFIG_HOME:-$HOME/.config}/dcc/registry"

# ---------------------------------------------------------------------------
# Paths / helpers
# ---------------------------------------------------------------------------

c_dim=''; c_b=''; c_r=''; c_y=''; c_g=''
if [ -t 1 ]; then
    c_dim=$'\033[2m'; c_b=$'\033[1m'; c_r=$'\033[31m'; c_y=$'\033[33m'; c_g=$'\033[32m'; c_0=$'\033[0m'
fi
c_0="${c_0:-}"

info() { printf '%s\n' "${c_dim}dcc:${c_0} $*" >&2; }
warn() { printf '%s\n' "${c_y}dcc:${c_0} $*" >&2; }
die()  { printf '%s\n' "${c_r}dcc:${c_0} $*" >&2; exit 1; }
ok()   { printf '%s\n' "${c_g}✓${c_0} $*" >&2; }

# Own path even through symlinks (brew links bin/dcc)
resolve_self() {
    local p="${BASH_SOURCE[0]}" d
    while [ -L "$p" ]; do
        d="$(cd -P "$(dirname "$p")" && pwd)"
        p="$(readlink "$p")"
        case "$p" in /*) ;; *) p="$d/$p" ;; esac
    done
    cd -P "$(dirname "$p")" && pwd
}

BIN_DIR="$(resolve_self)"
IMAGE_DIR=""
for cand in "$BIN_DIR/../image" "$BIN_DIR/../share/dcc/image" "$BIN_DIR/../libexec/image"; do
    if [ -f "$cand/Dockerfile" ]; then IMAGE_DIR="$(cd "$cand" && pwd)"; break; fi
done
[ -n "$IMAGE_DIR" ] || die "couldn't find a directory with a Dockerfile (looked next to $BIN_DIR)"

expand_tilde() { case "$1" in "~"|"~/"*) printf '%s' "$HOME${1#\~}" ;; *) printf '%s' "$1" ;; esac; }
abspath()      { (cd "$1" 2>/dev/null && pwd); }
port_free()    { ! (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; }

need_docker() {
    command -v docker >/dev/null 2>&1 || die "docker is not installed"
    docker info >/dev/null 2>&1 || die "docker daemon is not running"
    docker compose version >/dev/null 2>&1 || die "missing the 'docker compose' (v2) plugin"
}

# ---------------------------------------------------------------------------
# Instance: discovery, loading
# ---------------------------------------------------------------------------

HOME_DIR=""; PROJECT=""; IMAGE=""; PORT_BASE=""

# 1) .dcc/ in the current directory or an ancestor
find_home_upwards() {
    local d="$PWD"
    while [ "$d" != "/" ]; do
        [ -f "$d/.dcc/instance" ] && { printf '%s' "$d"; return 0; }
        d="$(dirname "$d")"
    done
    return 1
}

# 2) cwd lies inside a mounted directory of a registered instance
find_home_via_mounts() {
    [ -f "$REGISTRY" ] || return 1
    local home host best="" best_len=0
    while IFS= read -r home; do
        [ -n "$home" ] && [ -f "$home/.dcc/mounts" ] || continue
        while IFS='|' read -r host _ _; do
            [ -n "$host" ] || continue
            case "$PWD/" in
                "$host"/*|"$host/")
                    if [ "${#host}" -gt "$best_len" ]; then best="$home"; best_len="${#host}"; fi
                    ;;
            esac
        done < "$home/.dcc/mounts"
    done < "$REGISTRY"
    [ -n "$best" ] && { printf '%s' "$best"; return 0; }
    return 1
}

load_instance() {
    HOME_DIR="$(find_home_upwards || find_home_via_mounts || true)"
    [ -n "$HOME_DIR" ] || die "not inside any dcc instance.
    Run ${c_b}dcc create${c_0} in the directory that should be the home for Claude Code,
    or move into one of the mounted directories (${c_b}dcc homes${c_0})."
    # shellcheck disable=SC1090
    . "$HOME_DIR/.dcc/instance"
}

compose() { docker compose --project-directory "$HOME_DIR/.dcc" "$@"; }

# Map a host path to its path inside the container (longest match wins)
container_path() {
    local target="${1:-$PWD}" host cont mode best="/workspace" best_len=0 rel
    case "$target/" in
        "$HOME_DIR"/*|"$HOME_DIR/") printf '/home/dev/.claude%s' "${target#$HOME_DIR}"; return ;;
    esac
    while IFS='|' read -r host cont mode; do
        [ -n "$host" ] || continue
        case "$target/" in
            "$host"/*|"$host/")
                if [ "${#host}" -gt "$best_len" ]; then
                    rel="${target#$host}"; best="$cont$rel"; best_len="${#host}"
                fi
                ;;
        esac
    done < "$HOME_DIR/.dcc/mounts"
    printf '%s' "$best"
}

# ---------------------------------------------------------------------------
# Compose generation
# ---------------------------------------------------------------------------

generate_compose() {
    local out="$HOME_DIR/.dcc/docker-compose.yml"
    local host cont mode
    {
        echo "# Generated by dcc $DCC_VERSION – do not edit by hand,"
        echo "# use 'dcc mount add|rm' and 'dcc up' instead."
        echo "name: $PROJECT"
        echo
        echo "services:"
        echo "  claude:"
        echo "    image: $IMAGE"
        echo "    container_name: $PROJECT"
        echo "    hostname: ${PROJECT#dcc-}"
        echo "    init: true"
        echo "    stdin_open: true"
        echo "    tty: true"
        echo "    working_dir: /workspace"
        echo "    command: [\"sleep\", \"infinity\"]"
        echo "    environment:"
        echo "      HOST_UID: \"\${HOST_UID:-1000}\""
        echo "      HOST_GID: \"\${HOST_GID:-1000}\""
        echo "      TZ: \"\${TZ:-UTC}\""
        echo "      CLAUDE_CONFIG_DIR: /home/dev/.claude"
        echo "    volumes:"
        echo "      - \"$HOME_DIR:/home/dev/.claude\""
        while IFS='|' read -r host cont mode; do
            [ -n "$host" ] || continue
            if [ "$mode" = "ro" ]; then
                echo "      - \"$host:$cont:ro\""
            else
                echo "      - \"$host:$cont\""
            fi
        done < "$HOME_DIR/.dcc/mounts"
        echo "      - \"$PROJECT-cache:/home/dev/.cache\""
        echo "    ports:"
        echo "      - \"127.0.0.1:$PORT_BASE-$((PORT_BASE+9)):$PORT_BASE-$((PORT_BASE+9))\""
        if port_free 54545; then
            echo "      - \"127.0.0.1:54545:54545\"   # OAuth callback"
        fi
        echo "    extra_hosts:"
        echo "      - \"host.docker.internal:host-gateway\""
        echo
        echo "volumes:"
        echo "  $PROJECT-cache:"
    } > "$out"
}

save_instance() {
    cat > "$HOME_DIR/.dcc/instance" <<EOF
# Generated by dcc – manual edits are fine, then run 'dcc up'
PROJECT="$PROJECT"
IMAGE="$IMAGE"
PORT_BASE="$PORT_BASE"
DCC_VERSION="$DCC_VERSION"
EOF
}

register_home() {
    mkdir -p "$(dirname "$REGISTRY")"
    touch "$REGISTRY"
    grep -qxF "$HOME_DIR" "$REGISTRY" || printf '%s\n' "$HOME_DIR" >> "$REGISTRY"
}

# ---------------------------------------------------------------------------
# Docker operations
# ---------------------------------------------------------------------------

image_exists() { docker image inspect "$1" >/dev/null 2>&1; }

build_base() {
    info "building base image $BASE_IMAGE…"
    docker build -t "$BASE_IMAGE" "$@" "$IMAGE_DIR"
    ok "image $BASE_IMAGE ready"
}

running() { [ -n "$(compose ps --status running --quiet claude 2>/dev/null)" ]; }

ensure_up() {
    running && return 0
    image_exists "$IMAGE" || {
        [ "$IMAGE" = "$BASE_IMAGE" ] || die "image $IMAGE doesn't exist – try 'dcc reset'"
        build_base
    }
    info "starting container $PROJECT…"
    HOST_UID="$(id -u)" HOST_GID="$(id -g)" TZ="${TZ:-$(host_tz)}" compose up -d
    local i
    for i in $(seq 40); do
        compose exec -T --user dev claude test -f /tmp/.dcc-ready 2>/dev/null && return 0
        sleep 0.3
    done
    die "container failed to come up – 'dcc logs'"
}

host_tz() {
    if [ -n "${TZ:-}" ]; then printf '%s' "$TZ"
    elif [ -L /etc/localtime ]; then readlink /etc/localtime | sed 's#.*/zoneinfo/##'
    else printf 'UTC'; fi
}

enter() {
    local wd="$1"; shift
    ensure_up
    compose exec --user dev -e HOME=/home/dev -w "$wd" claude "$@"
}

# ---------------------------------------------------------------------------
# dcc create
# ---------------------------------------------------------------------------

cmd_create() {
    need_docker
    local target="${1:-$PWD}"
    target="$(expand_tilde "$target")"
    mkdir -p "$target"
    HOME_DIR="$(abspath "$target")" || die "can't open $target"

    [ -f "$HOME_DIR/.dcc/instance" ] && die "an instance already exists in $HOME_DIR"

    printf '\n%s\n' "${c_b}Home for Claude Code${c_0}"
    printf '  %s\n' "$HOME_DIR"
    printf '%s\n\n' "${c_dim}  CLAUDE.md, settings.json, skills/, commands/, agents/, login
  and session history will be stored here. Inside the container it's ~/.claude.${c_0}"
    read -r -p "Continue? [Y/n] " a; case "$a" in [nN]*) exit 1 ;; esac

    mkdir -p "$HOME_DIR/.dcc" "$HOME_DIR/skills" "$HOME_DIR/commands" "$HOME_DIR/agents"
    : > "$HOME_DIR/.dcc/mounts"

    printf '\n%s\n' "${c_b}Directories to mount${c_0}"
    printf '%s\n' "${c_dim}  Typically a folder with projects, shared libraries, ~/.m2, etc.
  An empty line ends the list.${c_0}"

    local spec host cont mode suggested
    while :; do
        printf '\n'
        read -r -p "Directory on the host (Enter = done): " spec
        [ -z "$spec" ] && break
        host="$(expand_tilde "$spec")"
        if [ ! -d "$host" ]; then
            warn "doesn't exist: $host"
            read -r -p "  Create it? [y/N] " a
            case "$a" in [yY]*) mkdir -p "$host" ;; *) continue ;; esac
        fi
        host="$(abspath "$host")"
        if grep -q "^$host|" "$HOME_DIR/.dcc/mounts" 2>/dev/null; then
            warn "already added"; continue
        fi
        case "$HOME_DIR/" in "$host"/*) warn "the home can't live inside a mount – skipping"; continue ;; esac

        case "$(basename "$host")" in
            .m2)  suggested="/home/dev/.m2" ;;
            .gradle) suggested="/home/dev/.gradle" ;;
            .npm) suggested="/home/dev/.npm" ;;
            workspace|projects|repos|code|src|dev)
                  if [ -s "$HOME_DIR/.dcc/mounts" ]; then
                      suggested="/workspace/$(basename "$host")"
                  else
                      suggested="/workspace"
                  fi ;;
            *)    suggested="/workspace/$(basename "$host")" ;;
        esac
        read -r -p "  Path inside the container [$suggested]: " cont
        cont="${cont:-$suggested}"
        read -r -p "  Read-only? [y/N] " a
        case "$a" in [yY]*) mode="ro" ;; *) mode="rw" ;; esac

        printf '%s|%s|%s\n' "$host" "$cont" "$mode" >> "$HOME_DIR/.dcc/mounts"
        ok "$host → $cont${c_dim}$([ "$mode" = ro ] && echo ' (ro)')${c_0}"
    done

    [ -s "$HOME_DIR/.dcc/mounts" ] || warn "no mounts – Claude will only see its own home"

    # Project name + free port block
    local slug hash
    slug="$(basename "$HOME_DIR" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-' | sed 's/-\{2,\}/-/g;s/^-//;s/-$//')"
    hash="$(printf '%s' "$HOME_DIR" | cksum | cut -d' ' -f1 | tail -c 5)"
    PROJECT="dcc-${slug:-claude}-$hash"

    PORT_BASE=""
    local p
    for p in $(seq 8080 10 8500); do
        if port_free "$p" && port_free "$((p+9))"; then PORT_BASE="$p"; break; fi
    done
    [ -n "$PORT_BASE" ] || die "couldn't find a free port block between 8080–8509"

    IMAGE="$BASE_IMAGE"

    save_instance
    generate_compose
    register_home

    cat > "$HOME_DIR/.dcc/.gitignore" <<'EOF'
docker-compose.yml
EOF
    [ -f "$HOME_DIR/.gitignore" ] || cat > "$HOME_DIR/.gitignore" <<'EOF'
# Credentials and runtime clutter – do version skills/commands/CLAUDE.md.
.credentials.json
.claude.json
.claude.json.backup
history.jsonl
projects/
todos/
shell-snapshots/
statsig/
backups/
file-history/
ide/
EOF

    printf '\n'
    ok "instance ${c_b}$PROJECT${c_0} created (ports $PORT_BASE–$((PORT_BASE+9)))"

    image_exists "$BASE_IMAGE" || build_base
    ensure_up

    printf '\n%s\n' "Now log in:  ${c_b}dcc login${c_0}"
    printf '%s\n\n' "After that just type ${c_b}dcc${c_0} anywhere inside a mounted directory."
}

# ---------------------------------------------------------------------------
# Other commands
# ---------------------------------------------------------------------------

cmd_mount() {
    load_instance
    local sub="${1:-list}"; shift || true
    case "$sub" in
        list|ls)
            printf '%s\n' "${c_b}$HOME_DIR${c_0} → /home/dev/.claude"
            local host cont mode
            while IFS='|' read -r host cont mode; do
                [ -n "$host" ] || continue
                printf '%s → %s%s\n' "$host" "$cont" "$([ "$mode" = ro ] && echo ' (ro)')"
            done < "$HOME_DIR/.dcc/mounts"
            ;;
        add)
            local host="${1:-}" cont="${2:-}" mode="${3:-rw}"
            [ -n "$host" ] || die "usage: dcc mount add <directory> [container-path] [rw|ro]"
            host="$(expand_tilde "$host")"
            [ -d "$host" ] || die "directory doesn't exist: $host"
            host="$(abspath "$host")"
            cont="${cont:-/workspace/$(basename "$host")}"
            grep -q "^$host|" "$HOME_DIR/.dcc/mounts" && die "already added"
            printf '%s|%s|%s\n' "$host" "$cont" "$mode" >> "$HOME_DIR/.dcc/mounts"
            generate_compose
            ok "added $host → $cont; applying…"
            compose up -d --force-recreate
            ;;
        rm|remove)
            local host="${1:-}"
            [ -n "$host" ] || die "usage: dcc mount rm <directory>"
            host="$(abspath "$(expand_tilde "$host")")" || die "doesn't exist"
            grep -v "^$host|" "$HOME_DIR/.dcc/mounts" > "$HOME_DIR/.dcc/mounts.tmp" || true
            mv "$HOME_DIR/.dcc/mounts.tmp" "$HOME_DIR/.dcc/mounts"
            generate_compose
            ok "removed; applying…"
            compose up -d --force-recreate
            ;;
        *) die "unknown subcommand: $sub" ;;
    esac
}

cmd_snapshot() {
    load_instance
    running || die "container is not running"
    local tag="${1:-$PROJECT:snapshot}"
    info "baking the current container state into $tag…"
    docker commit "$PROJECT" "$tag" >/dev/null
    IMAGE="$tag"; save_instance; generate_compose
    ok "done – the instance now starts from $tag"
    printf '%s\n' "${c_dim}  Back to the clean base: dcc reset${c_0}"
}

cmd_reset() {
    load_instance
    IMAGE="$BASE_IMAGE"; save_instance; generate_compose
    compose up -d --force-recreate
    ok "instance running again from the base image"
}

cmd_doctor() {
    need_docker; ok "docker is running"
    load_instance
    printf '%s\n' "instance: ${c_b}$PROJECT${c_0}"
    printf '%s\n' "home:     $HOME_DIR"
    printf '%s\n' "image:    $IMAGE $(image_exists "$IMAGE" && echo "${c_g}(exists)${c_0}" || echo "${c_r}(missing)${c_0}")"
    printf '%s\n' "ports:    $PORT_BASE–$((PORT_BASE+9))"
    running && ok "container is running" || warn "container is not running"
    local host cont mode
    while IFS='|' read -r host cont mode; do
        [ -n "$host" ] || continue
        [ -d "$host" ] && ok "mount $host" || warn "MISSING $host (mount will fail)"
    done < "$HOME_DIR/.dcc/mounts"
    if [ -f "$HOME_DIR/.credentials.json" ] || [ -f "$HOME_DIR/.claude.json" ]; then
        ok "logged in"
    else
        warn "not logged in – run 'dcc login'"
    fi
    port_free 54545 || warn "port 54545 is taken (another instance?) – paste the code manually when logging in"
}

cmd_homes() {
    [ -f "$REGISTRY" ] || die "no instance"
    local home
    while IFS= read -r home; do
        [ -n "$home" ] || continue
        if [ -f "$home/.dcc/instance" ]; then
            printf '%s\n' "$home"
            sed -n 's/^\(.*\)|\(.*\)|.*$/    \1 → \2/p' "$home/.dcc/mounts" 2>/dev/null
        else
            printf '%s\n' "${c_dim}$home (gone)${c_0}"
        fi
    done < "$REGISTRY"
}

cmd_destroy() {
    load_instance
    read -r -p "Delete the container and cache of instance $PROJECT? The home on disk stays. [y/N] " a
    case "$a" in [yY]*) ;; *) exit 1 ;; esac
    compose down -v || true
    grep -vxF "$HOME_DIR" "$REGISTRY" > "$REGISTRY.tmp" 2>/dev/null || true
    mv "$REGISTRY.tmp" "$REGISTRY" 2>/dev/null || true
    ok "done ($HOME_DIR/.dcc is still there, delete it by hand if you want)"
}

usage() {
    cat <<EOF
${c_b}dcc${c_0} – Claude Code in an isolated Docker container (v$DCC_VERSION)

  ${c_b}dcc create${c_0} [dir]     first-time setup: turns this directory into a
                       home for Claude Code and interactively adds mounts
  ${c_b}dcc${c_0}                  runs Claude Code (in the matching directory)
  ${c_b}dcc login${c_0}            log in to your account
  ${c_b}dcc shell${c_0}            bash inside the container
  ${c_b}dcc exec${c_0} -- <cmd>    run a one-off command

  ${c_b}dcc mount${c_0} list|add|rm      manage mounted directories
  ${c_b}dcc up${c_0} | down | restart | status | logs
  ${c_b}dcc doctor${c_0}           diagnose the instance
  ${c_b}dcc homes${c_0}            list all instances

  ${c_b}dcc build${c_0}            (re)build the base image
  ${c_b}dcc update${c_0}           base image from scratch + restart
  ${c_b}dcc snapshot${c_0} [tag]   bake the current container state into an image
  ${c_b}dcc reset${c_0}            back to the clean base image
  ${c_b}dcc destroy${c_0}          remove the container and cache (home stays)
EOF
}

# ---------------------------------------------------------------------------

case "${1:-run}" in
    create)   shift; cmd_create "$@" ;;
    mount)    shift; cmd_mount "$@" ;;
    snapshot) shift; cmd_snapshot "$@" ;;
    reset)    shift; cmd_reset ;;
    doctor)   shift; cmd_doctor ;;
    homes)    shift; cmd_homes ;;
    destroy)  shift; cmd_destroy ;;

    build)    shift; need_docker; build_base "$@" ;;
    update)   shift; need_docker; build_base --no-cache --pull
              load_instance; compose up -d --force-recreate ;;

    up)       load_instance; ensure_up; ok "running" ;;
    down)     load_instance; compose down ;;
    restart)  load_instance; compose down; ensure_up ;;
    status)   load_instance; compose ps ;;
    logs)     shift; load_instance; compose logs "$@" ;;

    login)    load_instance; enter "$(container_path)" claude ;;
    shell)    load_instance; enter "$(container_path)" bash ;;
    exec)     shift; [ "${1:-}" = "--" ] && shift
              [ $# -gt 0 ] || die "missing command"
              load_instance; enter "$(container_path)" "$@" ;;

    -v|--version) printf 'dcc %s\n' "$DCC_VERSION" ;;
    -h|--help|help) usage ;;
    run)      load_instance; enter "$(container_path)" claude --dangerously-skip-permissions ;;
    -*)       die "unknown flag: $1 (dcc --help)" ;;
    *)        # dcc <mount subdirectory> – quick jump into a project
              load_instance
              target="$(abspath "$1")" || die "unknown command or directory: $1"
              enter "$(container_path "$target")" claude --dangerously-skip-permissions ;;
esac
