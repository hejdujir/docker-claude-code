#!/usr/bin/env bash
#
# dcc – docker-claude-code
# Claude Code with full permissions inside an isolated Docker container.
#
set -euo pipefail

DCC_VERSION="0.1.7"
BASE_IMAGE="${DCC_BASE_IMAGE:-dcc-base:latest}"
REGISTRY="${XDG_CONFIG_HOME:-$HOME/.config}/dcc/registry"

# ---------------------------------------------------------------------------
# Paths / helpers
# ---------------------------------------------------------------------------

c_dim=''; c_b=''; c_r=''; c_y=''; c_g=''; c_c=''
if [ -t 1 ]; then
    c_dim=$'\033[2m'; c_b=$'\033[1m'; c_r=$'\033[31m'; c_y=$'\033[33m'; c_g=$'\033[32m'; c_c=$'\033[36m'; c_0=$'\033[0m'
fi
c_0="${c_0:-}"
c_m=''; c_bl=''; c_bc=''
INST_COLORS=('')
if [ -t 1 ]; then
    c_m=$'\033[35m'; c_bl=$'\033[34m'; c_bc=$'\033[96m'
    # one colour per instance in the overview, picked by registry order
    INST_COLORS=($'\033[94m' $'\033[95m' $'\033[36m' $'\033[34m' $'\033[35m' $'\033[96m')
fi

info() { printf '%s\n' "${c_dim}dcc:${c_0} $*" >&2; }
warn() { printf '%s\n' "${c_y}dcc:${c_0} $*" >&2; }
die()  { printf '%s\n' "${c_r}dcc:${c_0} $*" >&2; exit 1; }
ok()   { printf '%s\n' "${c_g}✓${c_0} $*" >&2; }

# Own path even through symlinks (brew links bin/dcc)
resolve_self() {
    local p="${BASH_SOURCE[0]}" d
    while [ -L "$p" ]; do
        d="$(cd -P "$(dirname "$p")" && pwd)"
        p="$(readlink "$p")"
        case "$p" in /*) ;; *) p="$d/$p" ;; esac
    done
    cd -P "$(dirname "$p")" && pwd
}

BIN_DIR="$(resolve_self)"
DCC_SELF="$BIN_DIR/$(basename "${BASH_SOURCE[0]}")"
IMAGE_DIR=""
for cand in "$BIN_DIR/../image" "$BIN_DIR/../share/dcc/image" "$BIN_DIR/../libexec/image"; do
    if [ -f "$cand/Dockerfile" ]; then IMAGE_DIR="$(cd "$cand" && pwd)"; break; fi
done
[ -n "$IMAGE_DIR" ] || die "couldn't find a directory with a Dockerfile (looked next to $BIN_DIR)"

# Prepackaged skills are optional – an install without them just skips that step in `create`.
SKILLS_DIR=""
for cand in "$BIN_DIR/../skills" "$BIN_DIR/../share/dcc/skills" "$BIN_DIR/../libexec/skills"; do
    if [ -d "$cand" ]; then SKILLS_DIR="$(cd "$cand" && pwd)"; break; fi
done

expand_tilde() { case "$1" in "~"|"~/"*) printf '%s' "$HOME${1#\~}" ;; *) printf '%s' "$1" ;; esac; }
abspath()      { (cd "$1" 2>/dev/null && pwd); }
port_free()    { ! (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; }
slugify()      { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-' | sed 's/-\{2,\}/-/g;s/^-//;s/-$//'; }

need_docker() {
    command -v docker >/dev/null 2>&1 || die "docker is not installed"
    docker info >/dev/null 2>&1 || die "docker daemon is not running"
    docker compose version >/dev/null 2>&1 || die "missing the 'docker compose' (v2) plugin"
}

# ---------------------------------------------------------------------------
# Reading files under .dcc/ – never source or eval them
# ---------------------------------------------------------------------------
#
# The home is mounted read-write into the container, so everything under
# $HOME_DIR/.dcc/ has to be treated as untrusted input on the host: it is
# parsed as data, and every value is validated before it is used in shell
# arithmetic, docker commands or the generated compose file.

valid_project()  { case "$1" in ''|[!A-Za-z0-9]*|*[!A-Za-z0-9_.-]*) return 1 ;; esac; [ "${#1}" -le 63 ]; }
valid_image()    { case "$1" in ''|[!A-Za-z0-9]*|*[!A-Za-z0-9_.:/@-]*) return 1 ;; esac; [ "${#1}" -le 255 ]; }
valid_port()     { case "$1" in ''|*[!0-9]*|0*) return 1 ;; esac; [ "${#1}" -le 5 ] && [ "$1" -le 65535 ]; }
valid_port_base(){ valid_port "$1" && [ "$1" -le 65526 ]; }
valid_flag()     { case "$1" in 0|1) return 0 ;; *) return 1 ;; esac; }
valid_version()  { case "$1" in ''|*[!A-Za-z0-9_.+-]*) return 1 ;; esac; }
# Paths end up inside a double-quoted YAML string and a docker volume spec:
# they must be absolute and free of quotes, backslashes, '$' (compose
# interpolation), ':' (volume option separator) and control characters.
valid_path() {
    case "$1" in /*) ;; *) return 1 ;; esac
    case "$1" in *'"'*|*\\*|*'$'*|*:*|*'`'*|*[[:cntrl:]]*) return 1 ;; esac
    return 0
}
valid_mode()     { case "$1" in rw|ro) return 0 ;; *) return 1 ;; esac; }

# parse_instance <file> – reads the known KEY=value / KEY="value" lines of an
# instance file into I_PROJECT, I_IMAGE, I_PORT_BASE, I_OAUTH_PORT and
# I_DCC_VERSION. Fails (and sets I_ERROR) on anything else: unknown keys,
# shell syntax, invalid values. Nothing in the file is ever executed.
parse_instance() {
    local file="$1" line key val n=0
    I_PROJECT=""; I_IMAGE=""; I_PORT_BASE=""; I_OAUTH_PORT=""; I_DCC_VERSION=""; I_ERROR=""
    [ -f "$file" ] || { I_ERROR="missing"; return 1; }
    while IFS= read -r line || [ -n "$line" ]; do
        n=$((n+1))
        # trim surrounding whitespace (incl. a CR from a CRLF file)
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        case "$line" in ''|'#'*) continue ;; esac
        case "$line" in
            [A-Z_]*=*) key="${line%%=*}"; val="${line#*=}" ;;
            *) I_ERROR="line $n is not KEY=value"; return 1 ;;
        esac
        case "$val" in
            \"*\") val="${val#\"}"; val="${val%\"}" ;;
            \'*\') val="${val#\'}"; val="${val%\'}" ;;
        esac
        case "$key" in
            PROJECT)     valid_project "$val"   || { I_ERROR="invalid PROJECT (line $n)"; return 1; }; I_PROJECT="$val" ;;
            IMAGE)       valid_image "$val"     || { I_ERROR="invalid IMAGE (line $n)"; return 1; }; I_IMAGE="$val" ;;
            PORT_BASE)   valid_port_base "$val" || { I_ERROR="invalid PORT_BASE (line $n)"; return 1; }; I_PORT_BASE="$val" ;;
            OAUTH_PORT)  [ -z "$val" ] || valid_flag "$val" || { I_ERROR="invalid OAUTH_PORT (line $n)"; return 1; }; I_OAUTH_PORT="$val" ;;
            DCC_VERSION) [ -z "$val" ] || valid_version "$val" || { I_ERROR="invalid DCC_VERSION (line $n)"; return 1; }; I_DCC_VERSION="$val" ;;
            *) I_ERROR="unknown key '$key' (line $n)"; return 1 ;;
        esac
    done < "$file"
    [ -n "$I_PROJECT" ]   || { I_ERROR="PROJECT is missing"; return 1; }
    [ -n "$I_IMAGE" ]     || { I_ERROR="IMAGE is missing"; return 1; }
    [ -n "$I_PORT_BASE" ] || { I_ERROR="PORT_BASE is missing"; return 1; }
    return 0
}

# check_mounts <file> / check_ports <file> – every non-empty line must be
# well-formed, otherwise the whole file is rejected (never half-applied).
check_mounts() {
    local file="$1" host cont mode extra n=0
    [ -f "$file" ] || return 0
    while IFS='|' read -r host cont mode extra || [ -n "$host" ]; do
        n=$((n+1))
        [ -n "$host$cont$mode$extra" ] || continue
        if [ -n "$extra" ] || ! valid_path "$host" || ! valid_path "$cont" || ! valid_mode "$mode"; then
            I_ERROR="$file line $n is not <host-path>|<container-path>|rw|ro"; return 1
        fi
        case "$cont/" in
            /home/dev/.claude/.dcc/*|/home/dev/.claude/) I_ERROR="$file line $n: container path $cont is reserved"; return 1 ;;
        esac
    done < "$file"
    return 0
}

check_ports() {
    local file="$1" hp cp extra n=0
    [ -f "$file" ] || return 0
    while IFS='|' read -r hp cp extra || [ -n "$hp" ]; do
        n=$((n+1))
        [ -n "$hp$cp$extra" ] || continue
        if [ -n "$extra" ] || ! valid_port "$hp" || ! valid_port "$cp"; then
            I_ERROR="$file line $n is not <host-port>|<container-port>"; return 1
        fi
    done < "$file"
    return 0
}

# Is $1 a home listed in the host-side registry? The registry lives outside
# every container, so it decides which .dcc/ directories are real instances –
# a .dcc/instance planted inside a mounted project is not one.
home_registered() { [ -f "$REGISTRY" ] && grep -qxF "$1" "$REGISTRY"; }

# ---------------------------------------------------------------------------
# Instance: discovery, loading
# ---------------------------------------------------------------------------

HOME_DIR=""; PROJECT=""; IMAGE=""; PORT_BASE=""; OAUTH_PORT=""

# 1) .dcc/ in the current directory or an ancestor
find_home_upwards() {
    local d="$PWD"
    while [ "$d" != "/" ]; do
        if [ -f "$d/.dcc/instance" ]; then
            home_registered "$d" && { printf '%s' "$d"; return 0; }
            warn "ignoring $d/.dcc/instance – that directory is not in $REGISTRY"
        fi
        d="$(dirname "$d")"
    done
    return 1
}

# 2) cwd lies inside a mounted directory of a registered instance
find_home_via_mounts() {
    [ -f "$REGISTRY" ] || return 1
    local home host best="" best_len=0
    while IFS= read -r home; do
        [ -n "$home" ] && [ -f "$home/.dcc/mounts" ] || continue
        while IFS='|' read -r host _ _; do
            [ -n "$host" ] || continue
            case "$PWD/" in
                "$host"/*|"$host/")
                    if [ "${#host}" -gt "$best_len" ]; then best="$home"; best_len="${#host}"; fi
                    ;;
            esac
        done < "$home/.dcc/mounts"
    done < "$REGISTRY"
    [ -n "$best" ] && { printf '%s' "$best"; return 0; }
    return 1
}

load_instance() {
    # DCC_HOME picks the instance explicitly (dcc new / dcc top use it when
    # one folder is mounted into several instances)
    if [ -n "${DCC_HOME:-}" ]; then
        home_registered "$DCC_HOME" || die "DCC_HOME=$DCC_HOME is not a registered instance ($REGISTRY)"
        HOME_DIR="$DCC_HOME"
    else
        HOME_DIR="$(find_home_upwards || find_home_via_mounts || true)"
    fi
    [ -n "$HOME_DIR" ] || die "not inside any dcc instance.
    Run ${c_b}dcc create${c_0} in the directory that should be the home for Claude Code,
    or move into one of the mounted directories (${c_b}dcc homes${c_0})."
    parse_instance "$HOME_DIR/.dcc/instance" \
        || die "refusing to load $HOME_DIR/.dcc/instance: $I_ERROR.
    The file is only read as KEY=\"value\" lines (PROJECT, IMAGE, PORT_BASE, OAUTH_PORT, DCC_VERSION) – fix it by hand."
    PROJECT="$I_PROJECT"; IMAGE="$I_IMAGE"; PORT_BASE="$I_PORT_BASE"; OAUTH_PORT="$I_OAUTH_PORT"
    check_mounts "$HOME_DIR/.dcc/mounts" || die "refusing to use mounts: $I_ERROR"
    check_ports "$HOME_DIR/.dcc/ports"   || die "refusing to use ports: $I_ERROR"

    # Migrate instances created before OAUTH_PORT was tracked: infer
    # ownership from whatever the existing compose file already claims,
    # so upgrading dcc doesn't silently drop (or duplicate) the mapping.
    if [ -z "${OAUTH_PORT:-}" ]; then
        if [ -f "$HOME_DIR/.dcc/docker-compose.yml" ] && grep -q '54545' "$HOME_DIR/.dcc/docker-compose.yml" 2>/dev/null; then
            OAUTH_PORT=1
        else
            OAUTH_PORT=0
        fi
        save_instance
    fi

    if port_base_taken "$PORT_BASE"; then
        warn "port block $PORT_BASE-$((PORT_BASE+9)) is also claimed by another dcc instance – only one of them will actually bind. Run 'dcc homes' to see who else has it, then fix one side by hand: edit PORT_BASE in its .dcc/instance and run 'dcc restart'."
    fi

    # docker-compose.yml sits in the container-writable home too, so it is
    # never trusted: rebuild it from the validated values on every run.
    generate_compose
}

compose() { docker compose --project-directory "$HOME_DIR/.dcc" "$@"; }

# Map a host path to its path inside the container (longest match wins)
container_path() {
    local target="${1:-$PWD}" host cont mode best="/workspace" best_len=0 rel
    case "$target/" in
        "$HOME_DIR"/*|"$HOME_DIR/") printf '/home/dev/.claude%s' "${target#$HOME_DIR}"; return ;;
    esac
    while IFS='|' read -r host cont mode; do
        [ -n "$host" ] || continue
        case "$target/" in
            "$host"/*|"$host/")
                if [ "${#host}" -gt "$best_len" ]; then
                    rel="${target#$host}"; best="$cont$rel"; best_len="${#host}"
                fi
                ;;
        esac
    done < "$HOME_DIR/.dcc/mounts"
    printf '%s' "$best"
}

# ---------------------------------------------------------------------------
# Compose generation
# ---------------------------------------------------------------------------

generate_compose() {
    local out="$HOME_DIR/.dcc/docker-compose.yml"
    local host cont mode hp cp
    {
        echo "# Generated by dcc $DCC_VERSION – do not edit by hand,"
        echo "# use 'dcc mount add|rm' and 'dcc up' instead."
        echo "name: $PROJECT"
        echo
        echo "services:"
        echo "  claude:"
        echo "    image: $IMAGE"
        echo "    container_name: $PROJECT"
        echo "    hostname: ${PROJECT#dcc-}"
        echo "    init: true"
        echo "    stdin_open: true"
        echo "    tty: true"
        echo "    working_dir: /workspace"
        echo "    command: [\"sleep\", \"infinity\"]"
        echo "    environment:"
        echo "      HOST_UID: \"\${HOST_UID:-1000}\""
        echo "      HOST_GID: \"\${HOST_GID:-1000}\""
        echo "      TZ: \"\${TZ:-UTC}\""
        echo "      CLAUDE_CONFIG_DIR: /home/dev/.claude"
        echo "    volumes:"
        echo "      - \"$HOME_DIR:/home/dev/.claude\""
        # .dcc/ is read by dcc on the host – keep it read-only for the container
        echo "      - \"$HOME_DIR/.dcc:/home/dev/.claude/.dcc:ro\""
        while IFS='|' read -r host cont mode; do
            [ -n "$host" ] || continue
            if [ "$mode" = "ro" ]; then
                echo "      - \"$host:$cont:ro\""
            else
                echo "      - \"$host:$cont\""
            fi
        done < "$HOME_DIR/.dcc/mounts"
        echo "      - \"$PROJECT-cache:/home/dev/.cache\""
        echo "    ports:"
        echo "      - \"127.0.0.1:$PORT_BASE-$((PORT_BASE+9)):$PORT_BASE-$((PORT_BASE+9))\""
        if [ "$OAUTH_PORT" = "1" ]; then
            echo "      - \"127.0.0.1:54545:54545\"   # OAuth callback"
        fi
        if [ -f "$HOME_DIR/.dcc/ports" ]; then
            while IFS='|' read -r hp cp; do
                [ -n "$hp" ] || continue
                echo "      - \"127.0.0.1:$hp:$cp\""
            done < "$HOME_DIR/.dcc/ports"
        fi
        echo "    extra_hosts:"
        echo "      - \"host.docker.internal:host-gateway\""
        echo
        echo "volumes:"
        echo "  $PROJECT-cache:"
    } > "$out"
}

save_instance() {
    cat > "$HOME_DIR/.dcc/instance" <<EOF
# Generated by dcc – manual edits are fine, then run 'dcc up'
PROJECT="$PROJECT"
IMAGE="$IMAGE"
PORT_BASE="$PORT_BASE"
OAUTH_PORT="$OAUTH_PORT"
DCC_VERSION="$DCC_VERSION"
EOF
}

register_home() {
    mkdir -p "$(dirname "$REGISTRY")"
    touch "$REGISTRY"
    grep -qxF "$HOME_DIR" "$REGISTRY" || printf '%s\n' "$HOME_DIR" >> "$REGISTRY"
}

# Is $1 already used as a PROJECT name by some other registered instance?
project_taken() {
    local name="$1" home
    [ -f "$REGISTRY" ] || return 1
    while IFS= read -r home; do
        [ -n "$home" ] && [ "$home" != "$HOME_DIR" ] && [ -f "$home/.dcc/instance" ] || continue
        parse_instance "$home/.dcc/instance" && [ "$I_PROJECT" = "$name" ] && return 0
    done < "$REGISTRY"
    return 1
}

# Is port block $1 already used as PORT_BASE by some other registered instance?
# port_free() only sees ports that are *currently* bound, so without this,
# two instances created while one of them is stopped can end up with the
# same block and only one actually gets to bind it once both are running.
port_base_taken() {
    local target="$1" home
    [ -f "$REGISTRY" ] || return 1
    while IFS= read -r home; do
        [ -n "$home" ] && [ "$home" != "$HOME_DIR" ] && [ -f "$home/.dcc/instance" ] || continue
        parse_instance "$home/.dcc/instance" && [ "$I_PORT_BASE" = "$target" ] && return 0
    done < "$REGISTRY"
    return 1
}

# Does some other registered instance already own the 54545 OAuth port?
oauth_port_taken() {
    local home
    [ -f "$REGISTRY" ] || return 1
    while IFS= read -r home; do
        [ -n "$home" ] && [ "$home" != "$HOME_DIR" ] && [ -f "$home/.dcc/instance" ] || continue
        parse_instance "$home/.dcc/instance" && [ "$I_OAUTH_PORT" = "1" ] && return 0
    done < "$REGISTRY"
    return 1
}

# Is host port $1 already claimed by another registered instance – either
# inside its port block or as one of its own extra forwarded ports?
host_port_taken() {
    local target="$1" home base hp cp
    [ -f "$REGISTRY" ] || return 1
    while IFS= read -r home; do
        [ -n "$home" ] && [ "$home" != "$HOME_DIR" ] && [ -f "$home/.dcc/instance" ] || continue
        base=""; parse_instance "$home/.dcc/instance" && base="$I_PORT_BASE"
        if [ -n "$base" ] && [ "$target" -ge "$base" ] && [ "$target" -le "$((base+9))" ]; then
            return 0
        fi
        if [ -f "$home/.dcc/ports" ] && check_ports "$home/.dcc/ports"; then
            while IFS='|' read -r hp cp; do
                [ -n "$hp" ] || continue
                [ "$hp" = "$target" ] && return 0
            done < "$home/.dcc/ports"
        fi
    done < "$REGISTRY"
    return 1
}

# ---------------------------------------------------------------------------
# Docker operations
# ---------------------------------------------------------------------------

image_exists() { docker image inspect "$1" >/dev/null 2>&1; }

build_base() {
    info "building base image $BASE_IMAGE..."
    docker build -t "$BASE_IMAGE" "$@" "$IMAGE_DIR"
    ok "image $BASE_IMAGE ready"
}

running() { [ -n "$(compose ps --status running --quiet claude 2>/dev/null)" ]; }

ensure_up() {
    running && return 0
    image_exists "$IMAGE" || {
        [ "$IMAGE" = "$BASE_IMAGE" ] || die "image $IMAGE doesn't exist – try 'dcc reset'"
        build_base
    }
    info "starting container $PROJECT..."
    HOST_UID="$(id -u)" HOST_GID="$(id -g)" TZ="${TZ:-$(host_tz)}" compose up -d
    local i
    for i in $(seq 40); do
        compose exec -T --user dev claude test -f /tmp/.dcc-ready 2>/dev/null && return 0
        sleep 0.3
    done
    die "container failed to come up – 'dcc logs'"
}

host_tz() {
    if [ -n "${TZ:-}" ]; then printf '%s' "$TZ"
    elif [ -L /etc/localtime ]; then readlink /etc/localtime | sed 's#.*/zoneinfo/##'
    else printf 'UTC'; fi
}

enter() {
    local wd="$1"; shift
    ensure_up
    refresh_hook_script
    # Classic renderer by default: newer Claude Code draws in the terminal's
    # alternate screen, where the terminal keeps no scrollback, so the
    # conversation can't be scrolled back in iTerm & co. DCC_FULLSCREEN=1
    # keeps Claude Code's own choice (fullscreen, scrolled inside Claude).
    local render=(-e CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN=1)
    [ "${DCC_FULLSCREEN:-}" = 1 ] && render=()
    # Closing the tab doesn't end what 'docker exec' started inside the
    # container, so every session runs under launch.sh, which ends it once
    # this tab's heartbeat file goes away – or after DCC_IDLE_HOURS (default
    # 24, 0 = never) without a single keypress, for Claude Code itself.
    local tab="t$(date +%s)-$$-$RANDOM" idle="${DCC_IDLE_HOURS:-24}"
    case "$idle" in ''|*[!0-9]*) die "DCC_IDLE_HOURS must be a whole number of hours (0 = never)" ;; esac
    [ "$1" = claude ] || idle=0
    write_launcher
    start_heartbeat "$tab"
    compose exec --user dev -e HOME=/home/dev ${render[@]+"${render[@]}"} -w "$wd" claude \
        bash "/home/dev/.claude/$LAUNCH_REL" "$tab" "$idle" "$@"
}

# ---------------------------------------------------------------------------
# Session lifetime: launch.sh inside the container ends sessions whose tab
# on the host is gone, or that nobody has typed into for a long time
# ---------------------------------------------------------------------------

LAUNCH_REL=".dcc/bin/launch.sh"
TABS_REL=".dcc-tabs"

# <home>/.dcc-tabs/<tab> holds the time it was last refreshed. A background
# loop refreshes it every 30 s for as long as this dcc process lives and
# removes it once it's gone – also when the terminal closing killed dcc
# with a SIGHUP, which the loop itself ignores.
start_heartbeat() {
    local hb="$HOME_DIR/$TABS_REL/$1" parent=$$
    mkdir -p "$HOME_DIR/$TABS_REL"
    date +%s > "$hb"
    [ -f "$HOME_DIR/.gitignore" ] && ! grep -qxF "$TABS_REL/" "$HOME_DIR/.gitignore" \
        && printf '%s\n' "$TABS_REL/" >> "$HOME_DIR/.gitignore"
    (
        trap '' HUP INT TERM
        n=0
        while kill -0 "$parent" 2>/dev/null; do
            if [ $((n % 15)) -eq 0 ]; then date +%s > "$hb.tmp" && mv -f "$hb.tmp" "$hb"; fi
            n=$((n+1)); sleep 2
        done
        rm -f "$hb" "$hb.tmp"
    ) </dev/null >/dev/null 2>&1 &
}

write_launcher() {
    mkdir -p "$HOME_DIR/.dcc/bin"
    launch_script | cmp -s - "$HOME_DIR/$LAUNCH_REL" 2>/dev/null && return 0
    launch_script > "$HOME_DIR/$LAUNCH_REL.tmp" && mv "$HOME_DIR/$LAUNCH_REL.tmp" "$HOME_DIR/$LAUNCH_REL"
}

launch_script() {
    cat <<'LAUNCH'
#!/usr/bin/env bash
# dcc session launcher – generated by dcc, rewritten whenever it changes.
#   launch.sh <tab> <idle-hours> <command> [args...]
# Runs <command> in its own place (same PID), with a small watcher next to
# it that ends the command when
#   - the dcc tab on the host is gone: its heartbeat file <home>/.dcc-tabs/<tab>
#     disappears, or stops changing for 5 minutes the container was awake
#     (a closed terminal never reaches what 'docker exec' started), or
#   - nobody typed into it for <idle-hours> hours (0 = never).
# Ending is a SIGTERM – Claude Code saves the conversation, 'claude --resume'
# brings it back – and a SIGKILL 30 s later if it's still there. Every end
# is logged to <home>/.dcc-tabs/ended.log.
tab="${1:-}" idle="${2:-0}"; shift 2 || exit 64
case "$tab" in ""|*[!A-Za-z0-9_-]*) exec "$@" ;; esac
case "$idle" in ""|*[!0-9]*) idle=0 ;; esac
dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/.dcc-tabs"
hb="$dir/$tab"
pid=$$
# start time of this PID – it survives the exec, and tells a reused PID apart
born() { sed 's/.*) //' "/proc/$1/stat" 2>/dev/null | cut -d' ' -f20; }
start="$(born "$pid")"
tty="$(readlink /proc/self/fd/0 2>/dev/null)"
case "$tty" in /dev/pts/*) ;; *) tty="" ;; esac

(
    trap '' HUP INT QUIT TSTP
    alive() { [ -n "$start" ] && [ "$(born "$pid")" = "$start" ]; }
    finish() {
        printf '%s %s %s: %s\n' "$(date '+%F %T')" "$tab" "$1" \
            "$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | cut -c1-120)" >> "$dir/ended.log"
        tail -n 200 "$dir/ended.log" > "$dir/ended.log.tmp" 2>/dev/null && mv -f "$dir/ended.log.tmp" "$dir/ended.log"
        rm -f "$hb"     # a stuck tab never gets to remove its own
        kill -TERM "$pid" 2>/dev/null
        for _ in $(seq 30); do sleep 1; alive || exit 0; done
        kill -KILL "$pid" 2>/dev/null; exit 0
    }
    launched="$(date +%s)" last="" same=0 gone=0
    while sleep 5; do
        alive || exit 0
        if [ -e "$hb" ]; then
            gone=0; cur="$(cat "$hb" 2>/dev/null)"
            if [ "$cur" = "$last" ]; then same=$((same+1)); else same=0; last="$cur"; fi
            [ "$same" -ge 60 ] && finish "dcc tab stopped answering"
        else
            gone=$((gone+1)); [ "$gone" -ge 2 ] && finish "dcc tab closed"
        fi
        if [ "$idle" -gt 0 ] && [ -n "$tty" ]; then
            typed="$(stat -c %X "$tty" 2>/dev/null || echo 0)"     # last read = last keypress
            [ "$typed" -gt "$launched" ] 2>/dev/null || typed="$launched"
            [ $(( $(date +%s) - typed )) -ge $(( idle * 3600 )) ] && finish "no input for $idle h"
        fi
    done
) </dev/null >/dev/null 2>&1 &

exec "$@"
LAUNCH
}

# ---------------------------------------------------------------------------
# dcc create
# ---------------------------------------------------------------------------

cmd_create() {
    need_docker
    local target="${1:-$PWD}"
    target="$(expand_tilde "$target")"
    mkdir -p "$target"
    HOME_DIR="$(abspath "$target")" || die "can't open $target"

    [ -f "$HOME_DIR/.dcc/instance" ] && die "an instance already exists in $HOME_DIR"

    printf '\n%s\n' "${c_b}Home for Claude Code${c_0}"
    printf '  %s\n' "$HOME_DIR"
    printf '%s\n\n' "${c_dim}  CLAUDE.md, settings.json, skills/, commands/, agents/, login
  and session history will be stored here. Inside the container it's ~/.claude.${c_0}"
    read -r -p "Continue? [Y/n] " a; case "$a" in [nN]*) exit 1 ;; esac

    mkdir -p "$HOME_DIR/.dcc" "$HOME_DIR/skills" "$HOME_DIR/commands" "$HOME_DIR/agents"
    : > "$HOME_DIR/.dcc/mounts"
    : > "$HOME_DIR/.dcc/ports"

    printf '\n%s\n' "${c_b}Directories to mount${c_0}"
    printf '%s\n' "${c_dim}  Typically a folder with projects, shared libraries, ~/.m2, etc.
  An empty line ends the list.${c_0}"

    local spec host cont mode suggested
    while :; do
        printf '\n'
        read -r -p "Directory on the host (Enter = done): " spec
        [ -z "$spec" ] && break
        host="$(expand_tilde "$spec")"
        if [ ! -d "$host" ]; then
            warn "doesn't exist: $host"
            read -r -p "  Create it? [y/N] " a
            case "$a" in [yY]*) mkdir -p "$host" ;; *) continue ;; esac
        fi
        host="$(abspath "$host")"
        if grep -q "^$host|" "$HOME_DIR/.dcc/mounts" 2>/dev/null; then
            warn "already added"; continue
        fi
        case "$HOME_DIR/" in "$host"/*) warn "the home can't live inside a mount – skipping"; continue ;; esac

        case "$(basename "$host")" in
            .m2)  suggested="/home/dev/.m2" ;;
            .gradle) suggested="/home/dev/.gradle" ;;
            .npm) suggested="/home/dev/.npm" ;;
            workspace|projects|repos|code|src|dev)
                  if [ -s "$HOME_DIR/.dcc/mounts" ]; then
                      suggested="/workspace/$(basename "$host")"
                  else
                      suggested="/workspace"
                  fi ;;
            *)    suggested="/workspace/$(basename "$host")" ;;
        esac
        read -r -p "  Path inside the container [$suggested]: " cont
        cont="${cont:-$suggested}"
        read -r -p "  Read-only? [y/N] " a
        case "$a" in [yY]*) mode="ro" ;; *) mode="rw" ;; esac

        if ! valid_path "$host" || ! valid_path "$cont"; then
            warn "paths must be absolute and must not contain \" \\ \$ \` or : – skipping"; continue
        fi
        case "$cont/" in /home/dev/.claude/.dcc/*|/home/dev/.claude/) warn "$cont is reserved – skipping"; continue ;; esac
        printf '%s|%s|%s\n' "$host" "$cont" "$mode" >> "$HOME_DIR/.dcc/mounts"
        ok "$host → $cont${c_dim}$([ "$mode" = ro ] && echo ' (ro)')${c_0}"
    done

    [ -s "$HOME_DIR/.dcc/mounts" ] || warn "no mounts – Claude will only see its own home"

    # Prepackaged skills – just the `flow` skill (recon → spec → implement →
    # review, chained). It pulls in everything it needs via its `requires:`
    # frontmatter, so there's nothing else to ask about individually.
    if [ -n "$SKILLS_DIR" ] && [ -f "$SKILLS_DIR/flow/SKILL.md" ]; then
        local req_line req

        req_line="$(awk '/^---$/{c++; next} c==1 && /^requires:/{sub(/^requires:[[:space:]]*/,""); print; exit}' "$SKILLS_DIR/flow/SKILL.md")"
        req_line="$(printf '%s' "$req_line" | tr ',' ' ')"

        printf '\n%s\n' "${c_b}Flow skill${c_0}"
        printf '%s\n' "${c_dim}  recon → spec → implement → review, chained (+ grill-me for clarifying questions)${c_0}"
        read -r -p "Install it? [y/N] " a
        case "$a" in
            [yY]*)
                cp -R "$SKILLS_DIR/flow" "$HOME_DIR/skills/flow"
                ok "  flow"
                for req in $req_line; do
                    [ -f "$SKILLS_DIR/$req/SKILL.md" ] || continue
                    cp -R "$SKILLS_DIR/$req" "$HOME_DIR/skills/$req"
                    ok "  $req"
                done
                ;;
            *) ;;
        esac
    fi

    local want_hooks=0
    printf '\n%s\n' "${c_b}Session status${c_0}"
    printf '%s\n' "${c_dim}  A small hook in settings.json records what each session is doing,
  so 'dcc ps' / 'dcc top' can show it (incl. flow progress)${c_0}"
    read -r -p "Install it? [Y/n] " a
    case "$a" in [nN]*) ;; *) want_hooks=1 ;; esac

    # Project name + free port block
    local slug hash custom
    slug="$(slugify "$(basename "$HOME_DIR")")"
    hash="$(printf '%s' "$HOME_DIR" | cksum | cut -d' ' -f1 | tail -c 5)"
    PROJECT="dcc-${slug:-claude}-$hash"

    printf '\n%s\n' "${c_b}Name shown in Docker Desktop${c_0}"
    read -r -p "Instance name [$PROJECT]: " custom
    if [ -n "$custom" ]; then
        custom="$(slugify "$custom")"
        if [ -z "$custom" ]; then
            warn "that name has no usable characters – keeping $PROJECT"
        elif project_taken "$custom"; then
            warn "'$custom' is already used by another instance – keeping $PROJECT"
        else
            PROJECT="$custom"
        fi
    fi

    PORT_BASE=""
    local p
    for p in $(seq 8080 10 8500); do
        if port_free "$p" && port_free "$((p+9))" && ! port_base_taken "$p"; then PORT_BASE="$p"; break; fi
    done
    [ -n "$PORT_BASE" ] || die "couldn't find a free port block between 8080-8509"

    if port_free 54545 && ! oauth_port_taken; then OAUTH_PORT=1; else OAUTH_PORT=0; fi

    IMAGE="$BASE_IMAGE"

    save_instance
    generate_compose
    register_home

    cat > "$HOME_DIR/.dcc/.gitignore" <<'EOF'
docker-compose.yml
EOF
    [ -f "$HOME_DIR/.gitignore" ] || cat > "$HOME_DIR/.gitignore" <<'EOF'
# Credentials and runtime clutter – do version skills/commands/CLAUDE.md.
.credentials.json
.claude.json
.claude.json.backup
history.jsonl
projects/
todos/
shell-snapshots/
statsig/
backups/
file-history/
ide/
.dcc-status/
.dcc-tabs/
EOF

    printf '\n'
    ok "instance ${c_b}$PROJECT${c_0} created (ports $PORT_BASE-$((PORT_BASE+9)))"

    image_exists "$BASE_IMAGE" || build_base
    ensure_up
    [ "$want_hooks" = 1 ] && install_hooks

    printf '\n%s\n' "Now log in:  ${c_b}dcc login${c_0}"
    printf '%s\n\n' "After that just type ${c_b}dcc${c_0} anywhere inside a mounted directory."
}

# ---------------------------------------------------------------------------
# Other commands
# ---------------------------------------------------------------------------

cmd_mount() {
    load_instance
    local sub="${1:-list}"; shift || true
    case "$sub" in
        list|ls)
            printf '%s\n' "${c_b}$HOME_DIR${c_0} → /home/dev/.claude"
            local host cont mode
            while IFS='|' read -r host cont mode; do
                [ -n "$host" ] || continue
                printf '%s → %s%s\n' "$host" "$cont" "$([ "$mode" = ro ] && echo ' (ro)')"
            done < "$HOME_DIR/.dcc/mounts"
            ;;
        add)
            local host="${1:-}" cont="${2:-}" mode="${3:-rw}"
            [ -n "$host" ] || die "usage: dcc mount add <directory> [container-path] [rw|ro]"
            host="$(expand_tilde "$host")"
            [ -d "$host" ] || die "directory doesn't exist: $host"
            host="$(abspath "$host")"
            cont="${cont:-/workspace/$(basename "$host")}"
            grep -q "^$host|" "$HOME_DIR/.dcc/mounts" && die "already added"
            valid_mode "$mode" || die "mode must be rw or ro"
            valid_path "$host" && valid_path "$cont" || die "paths must be absolute and must not contain \" \\ \$ \` or :"
            case "$cont/" in /home/dev/.claude/.dcc/*|/home/dev/.claude/) die "$cont is reserved" ;; esac
            printf '%s|%s|%s\n' "$host" "$cont" "$mode" >> "$HOME_DIR/.dcc/mounts"
            generate_compose
            ok "added $host → $cont; applying…"
            compose up -d --force-recreate
            ;;
        rm|remove)
            local host="${1:-}"
            [ -n "$host" ] || die "usage: dcc mount rm <directory>"
            host="$(abspath "$(expand_tilde "$host")")" || die "doesn't exist"
            grep -v "^$host|" "$HOME_DIR/.dcc/mounts" > "$HOME_DIR/.dcc/mounts.tmp" || true
            mv "$HOME_DIR/.dcc/mounts.tmp" "$HOME_DIR/.dcc/mounts"
            generate_compose
            ok "removed; applying…"
            compose up -d --force-recreate
            ;;
        *) die "unknown subcommand: $sub" ;;
    esac
}

# Extra host<->container port forwards, beyond the instance's own
# PORT_BASE-PORT_BASE+9 block – e.g. a fixed port a dev server insists on.
cmd_port() {
    load_instance
    local sub="${1:-list}"; shift || true
    case "$sub" in
        list|ls)
            printf '%s\n' "${c_b}$PROJECT${c_0} block: $PORT_BASE-$((PORT_BASE+9))"
            if [ -s "$HOME_DIR/.dcc/ports" ]; then
                local hp cp
                while IFS='|' read -r hp cp; do
                    [ -n "$hp" ] || continue
                    printf '%s → %s\n' "$hp" "$cp"
                done < "$HOME_DIR/.dcc/ports"
            else
                printf '%s\n' "${c_dim}  no extra ports forwarded${c_0}"
            fi
            ;;
        add)
            local cport="${1:-}" hport="${2:-${1:-}}"
            [ -n "$cport" ] || die "usage: dcc port add <container-port> [host-port]"
            case "$cport" in ''|*[!0-9]*) die "container port must be numeric" ;; esac
            case "$hport" in ''|*[!0-9]*) die "host port must be numeric" ;; esac
            valid_port "$cport" && valid_port "$hport" || die "ports must be between 1 and 65535"
            touch "$HOME_DIR/.dcc/ports"
            if grep -q "^$hport|" "$HOME_DIR/.dcc/ports"; then
                die "host port $hport is already forwarded"
            fi
            if [ "$hport" -ge "$PORT_BASE" ] && [ "$hport" -le "$((PORT_BASE+9))" ]; then
                die "port $hport already falls inside this instance's block ($PORT_BASE-$((PORT_BASE+9))) – no need to forward it separately"
            fi
            if ! port_free "$hport"; then
                warn "port $hport doesn't look free on the host right now"
            fi
            if host_port_taken "$hport"; then
                die "port $hport is already used by another dcc instance"
            fi
            printf '%s|%s\n' "$hport" "$cport" >> "$HOME_DIR/.dcc/ports"
            generate_compose
            ok "forwarding host $hport -> container $cport; applying..."
            compose up -d --force-recreate
            ;;
        rm|remove)
            local hport="${1:-}"
            [ -n "$hport" ] || die "usage: dcc port rm <host-port>"
            if [ ! -f "$HOME_DIR/.dcc/ports" ]; then
                die "no extra ports forwarded"
            fi
            grep -v "^$hport|" "$HOME_DIR/.dcc/ports" > "$HOME_DIR/.dcc/ports.tmp" || true
            mv "$HOME_DIR/.dcc/ports.tmp" "$HOME_DIR/.dcc/ports"
            generate_compose
            ok "removed; applying..."
            compose up -d --force-recreate
            ;;
        *) die "unknown subcommand: $sub" ;;
    esac
}

cmd_snapshot() {
    load_instance
    running || die "container is not running"
    local tag="${1:-$PROJECT:snapshot}"
    info "baking the current container state into $tag..."
    docker commit "$PROJECT" "$tag" >/dev/null
    IMAGE="$tag"; save_instance; generate_compose
    ok "done – the instance now starts from $tag"
    printf '%s\n' "${c_dim}  Back to the clean base: dcc reset${c_0}"
}

cmd_reset() {
    load_instance
    IMAGE="$BASE_IMAGE"; save_instance; generate_compose
    compose up -d --force-recreate
    ok "instance running again from the base image"
}

cmd_claude_update() {
    load_instance
    ensure_up
    local cur latest new
    cur="$(compose exec -T --user dev claude claude --version 2>/dev/null | awk '{print $1}')"
    latest="$(compose exec -T --user dev claude npm view @anthropic-ai/claude-code version 2>/dev/null | tr -d '[:space:]')"
    [ -n "$latest" ] || die "couldn't look up the latest Claude Code version (no network in the container?)"
    if [ "$cur" = "$latest" ]; then
        ok "Claude Code is already up to date ($cur)"
        return 0
    fi
    info "Claude Code ${cur:-?} -> $latest (image $IMAGE)"

    if [ "$IMAGE" = "$BASE_IMAGE" ]; then
        # Base image is shared: rebuild only the Claude Code layer, then recreate
        # this container so the new version survives future recreates.
        read -r -p "Rebuild the Claude Code layer of $BASE_IMAGE and restart $PROJECT? Open sessions will be closed. [y/N] " a
        case "$a" in [yY]*) ;; *) exit 1 ;; esac
        build_base --build-arg CLAUDE_CACHEBUST="$(date +%s)"
        compose up -d --force-recreate
        ensure_up
    else
        # Snapshot: update in place, then re-bake the snapshot under the same tag.
        compose exec -T --user dev claude npm install -g @anthropic-ai/claude-code@latest >/dev/null
        read -r -p "Bake the update into snapshot $IMAGE? Without it, it's lost on the next recreate. [y/N] " a
        case "$a" in
            [yY]*) docker commit "$PROJECT" "$IMAGE" >/dev/null; ok "snapshot $IMAGE updated" ;;
            *)     warn "updated only in the running container – lost on the next recreate" ;;
        esac
    fi

    new="$(compose exec -T --user dev claude claude --version 2>/dev/null | awk '{print $1}')"
    ok "Claude Code ${new:-?}"
    [ "$IMAGE" = "$BASE_IMAGE" ] && printf '%s\n' "${c_dim}  Other instances on $BASE_IMAGE pick it up on their next 'dcc restart'${c_0}"
    return 0
}

cmd_doctor() {
    need_docker; ok "docker is running"
    load_instance
    printf '%s\n' "instance: ${c_b}$PROJECT${c_0}"
    printf '%s\n' "home:     $HOME_DIR"
    printf '%s\n' "image:    $IMAGE $(image_exists "$IMAGE" && echo "${c_g}(exists)${c_0}" || echo "${c_r}(missing)${c_0}")"
    printf '%s\n' "ports:    $PORT_BASE-$((PORT_BASE+9))"
    running && ok "container is running" || warn "container is not running"
    local host cont mode
    while IFS='|' read -r host cont mode; do
        [ -n "$host" ] || continue
        [ -d "$host" ] && ok "mount $host" || warn "MISSING $host (mount will fail)"
    done < "$HOME_DIR/.dcc/mounts"
    if [ -f "$HOME_DIR/.dcc/ports" ]; then
        local hp cp
        while IFS='|' read -r hp cp; do
            [ -n "$hp" ] || continue
            ok "port $hp -> $cp"
        done < "$HOME_DIR/.dcc/ports"
    fi
    if [ -f "$HOME_DIR/.credentials.json" ] || [ -f "$HOME_DIR/.claude.json" ]; then
        ok "logged in"
    else
        warn "not logged in – run 'dcc login'"
    fi
    if hooks_installed "$HOME_DIR"; then ok "session status hooks installed (dcc ps / top)"
    else warn "session status hooks not installed – 'dcc hooks install' for dcc ps / top"; fi
    if [ "$OAUTH_PORT" = "1" ]; then
        running || port_free 54545 || warn "port 54545 is claimed by this instance but is currently occupied by something else"
    else
        warn "OAuth callback port 54545 belongs to another dcc instance – paste the code manually when logging in"
    fi
}

cmd_homes() {
    [ -f "$REGISTRY" ] || die "no instance"
    local home
    while IFS= read -r home; do
        [ -n "$home" ] || continue
        if [ -f "$home/.dcc/instance" ]; then
            printf '%s\n' "$home"
            sed -n 's/^\(.*\)|\(.*\)|.*$/    \1 → \2/p' "$home/.dcc/mounts" 2>/dev/null
        else
            printf '%s\n' "${c_dim}$home (gone)${c_0}"
        fi
    done < "$REGISTRY"
}

cmd_destroy() {
    load_instance
    read -r -p "Delete the container and cache of instance $PROJECT? The home on disk stays. [y/N] " a
    case "$a" in [yY]*) ;; *) exit 1 ;; esac
    compose down -v || true
    grep -vxF "$HOME_DIR" "$REGISTRY" > "$REGISTRY.tmp" 2>/dev/null || true
    mv "$REGISTRY.tmp" "$REGISTRY" 2>/dev/null || true
    ok "done ($HOME_DIR/.dcc is still there, delete it by hand if you want)"
}

# ---------------------------------------------------------------------------
# Session status: a Claude Code hook records what every session is doing,
# and 'dcc ps' / 'dcc top' turn those records into an overview on the host
# ---------------------------------------------------------------------------

HOOK_REL=".dcc/hooks/status.sh"
HOOK_CMD="bash /home/dev/.claude/$HOOK_REL"
US=$'\x1f'

# The hook itself. It runs inside the container on every session event and
# writes one line per session to <home>/.dcc-status/<id> (not under .dcc/,
# which the container only gets read-only) – the host only ever reads those
# lines as plain data, never sources or executes them.
hook_script() {
    cat <<'HOOK'
#!/usr/bin/env bash
# dcc session-status hook – generated by dcc, 'dcc hooks install' rewrites it.
# Claude Code runs it on session/prompt/tool/subagent/stop events; it records
# each session's state for 'dcc ps' / 'dcc top' on the host. It must never
# fail loudly or print anything, so every error just ends it quietly.
#
# <dir>/<session>       one line: state, flow steps, subagents
# <dir>/<session>.flow  one line per flow subagent: step, models, tokens
exec 2>/dev/null
conf="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
dir="$conf/.dcc-status"
mkdir -p "$dir" || exit 0
US=$'\x1f'

IFS="$US" read -r ev sid cwd tool desc prompt msg resp agent transcript < <(jq -r '
    def clean: tostring | gsub("[[:cntrl:]]"; " ") | .[0:160];
    [ .hook_event_name, .session_id, .cwd, (.tool_name // ""),
      (.tool_input.description // ""), (.prompt // ""), (.message // ""),
      (if ((.tool_response // "") | tostring | test("NEEDS INPUT:")) then "ask" else "" end),
      (.agent_id // ""), (.transcript_path // "")
    ] | map(clean) | join("\u001f")') || exit 0
case "$sid" in ""|*[!A-Za-z0-9_-]*) exit 0 ;; esac
case "$agent" in *[!A-Za-z0-9_-]*) agent="" ;; esac

exec 9>"$dir/.lock" && flock -w 2 9 || exit 0

f="$dir/$sid"
v=""; state=""; started=""; updated=""; ltool=""; detail=""; flow=""; old_cwd=""
running=""; agents_total=""; flow_started=""
[ -f "$f" ] && IFS="$US" read -r v _ old_cwd state started updated ltool detail flow running agents_total flow_started < "$f"
now="$(date +%s)"
[ -n "$started" ] || started="$now"
[ -n "$cwd" ] || cwd="$old_cwd"
case "$agents_total" in ''|*[!0-9]*) agents_total=0 ;; esac
case "$flow_started" in *[!0-9]*) flow_started="" ;; esac

# flow: comma list of step=status (status: run | ask | done)
set_step() {
    local out="" item found=0 IFS=,
    for item in $flow; do
        [ -n "$item" ] || continue
        if [ "${item%%=*}" = "$1" ]; then item="$1=$2"; found=1; fi
        out="${out:+$out,}$item"
    done
    [ "$found" = 1 ] || out="${out:+$out,}$1=$2"
    flow="$out"
}
# every step still in $1 status becomes $2
move_steps() {
    local out="" item IFS=,
    for item in $flow; do
        [ -n "$item" ] || continue
        [ "${item#*=}" = "$1" ] && item="${item%%=*}=$2"
        out="${out:+$out,}$item"
    done
    flow="$out"
}
# running: comma list of subagent ids that started and haven't stopped yet
drop_agent() {
    local out="" a IFS=,
    for a in $running; do [ -n "$a" ] && [ "$a" != "$1" ] && out="${out:+$out,}$a"; done
    running="$out"
}
flow_step=""
case "$desc" in "flow:"*) flow_step="$(printf '%s' "${desc#flow:}" | tr -cd 'a-z-')" ;; esac

usage=0      # 1 = refresh <session>.flow now, 2 = only if it's older than 15 s
case "$ev" in
    SessionStart)
        state=idle; ltool=""; detail="" ;;
    UserPromptSubmit)
        state=working; ltool=""; detail="$prompt"
        case "$prompt" in
            /flow*) flow=""; flow_started="$now"; rm -f "$f.flow" ;;
            *) move_steps ask run ;;        # an answer relayed back into a waiting step
        esac ;;
    PreToolUse)
        state=working; ltool="$tool"; usage=2
        if [ "$tool" = AskUserQuestion ]; then
            state=waiting; detail="question"
        elif [ "$tool" = Agent ] && [ -n "$flow_step" ]; then
            move_steps run done; move_steps ask done   # steps run one after another
            set_step "$flow_step" run
        fi ;;
    PostToolUse)
        state=working; usage=2
        if [ "$tool" = Agent ] && [ -n "$flow_step" ]; then
            set_step "$flow_step" "$([ "$resp" = ask ] && echo ask || echo done)"; usage=1
        elif [ "$tool" = SendMessage ] && [ "$resp" = ask ]; then
            move_steps run ask
        fi ;;
    SubagentStart)
        [ -n "$agent" ] || exit 0
        drop_agent "$agent"; running="${running:+$running,}$agent"
        agents_total=$((agents_total+1)) ;;
    SubagentStop)
        [ -n "$agent" ] && drop_agent "$agent"; usage=1 ;;
    Notification)
        # The 60 s idle reminder after a finished turn isn't news – keep "done".
        case "$state:$msg" in
            done:*"waiting for your input"*) ;;
            *) state=waiting; detail="$msg" ;;
        esac ;;
    Stop)
        state=done; ltool=""; usage=1 ;;
    SessionEnd)
        state=ended; running="" ;;
    *) exit 0 ;;
esac

printf '%s\n' "1$US$sid$US$cwd$US$state$US$started$US$now$US$ltool$US$detail$US$flow$US$running$US$agents_total$US$flow_started" \
    > "$f.tmp" && mv "$f.tmp" "$f"

# Tokens of the current flow's subagents, from their own transcripts
# (<session>/subagents/agent-<id>.jsonl + .meta.json next to the session's).
# A streamed reply is logged once per content block with growing usage, so
# only the last line of each message id counts.
[ "$usage" != 0 ] && [ -n "$flow_started" ] || exit 0
if [ "$usage" = 2 ] && [ -f "$f.flow" ] && [ $((now - $(stat -c %Y "$f.flow" || echo 0))) -lt 15 ]; then exit 0; fi
case "$transcript" in "$conf/projects/"*.jsonl) ;; *) exit 0 ;; esac
case "$transcript" in *..*) exit 0 ;; esac
sub="${transcript%.jsonl}/subagents"
out=""
for meta in "$sub"/agent-*.meta.json; do
    [ -f "$meta" ] || continue
    id="${meta##*/agent-}"; id="${id%.meta.json}"
    case "$id" in ""|*[!A-Za-z0-9_-]*) continue ;; esac
    step="$(jq -r '.description // ""' "$meta")"
    case "$step" in "flow:"*) step="$(printf '%s' "${step#flow:}" | tr -cd 'a-z-')" ;; *) continue ;; esac
    [ -n "$step" ] && [ -f "$sub/agent-$id.jsonl" ] || continue
    line="$(jq -n -r --arg step "$step" '
        def ts: if type == "string" then sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601 else 0 end;
        reduce inputs as $l ({first: null, last: null, msgs: {}};
            (if .first == null then .first = $l.timestamp else . end)
            | .last = ($l.timestamp // .last)
            | if $l.type == "assistant" and ($l.message.id // null) != null
              then .msgs[$l.message.id] = {m: ($l.message.model // ""), u: ($l.message.usage // {})}
              else . end)
        | [ $step,
            ([.msgs[].m | select(. != "" and . != "<synthetic>") | sub("^claude-"; "")] | unique | join("+")),
            ([.msgs[].u | (.input_tokens // 0) + (.output_tokens // 0) + (.cache_creation_input_tokens // 0)] | add // 0),
            ([.msgs[].u.output_tokens // 0] | add // 0),
            (.first | ts), (.last | ts) ]
        | map(tostring | gsub("[[:cntrl:]]"; " ")) | join("\u001f")' "$sub/agent-$id.jsonl")" || continue
    first="$(printf '%s' "$line" | cut -d "$US" -f5)"
    case "$first" in ''|*[!0-9]*) continue ;; esac
    [ "$first" -ge $((flow_started - 5)) ] || continue        # an earlier /flow run
    is_run=0; case ",$running," in *",$id,"*) is_run=1 ;; esac
    out="$out$id$US$line$US$is_run"$'\n'
done
printf '%s' "$out" > "$f.flow.tmp" && mv "$f.flow.tmp" "$f.flow"
exit 0
HOOK
}

hooks_installed() { grep -qF "$HOOK_REL" "$1/settings.json" 2>/dev/null; }

write_hook_script() {
    mkdir -p "$HOME_DIR/.dcc/hooks" "$HOME_DIR/.dcc-status"
    hook_script > "$HOME_DIR/$HOOK_REL.tmp" && mv "$HOME_DIR/$HOOK_REL.tmp" "$HOME_DIR/$HOOK_REL"
    rm -rf "${HOME_DIR:?}/.dcc/sessions"    # where dcc 0.1.5's first take kept them
    [ -f "$HOME_DIR/.gitignore" ] && ! grep -qxF '.dcc-status/' "$HOME_DIR/.gitignore" \
        && printf '%s\n' '.dcc-status/' >> "$HOME_DIR/.gitignore"
    return 0
}

# Keep an already installed hook in step with this dcc version: the script
# itself, and the events it's registered for (subagent events came later).
refresh_hook_script() {
    [ -f "$HOME_DIR/$HOOK_REL" ] || return 0
    hook_script | cmp -s - "$HOME_DIR/$HOOK_REL" || write_hook_script
    if hooks_installed "$HOME_DIR" && ! grep -q '"SubagentStart"' "$HOME_DIR/settings.json" 2>/dev/null; then
        edit_settings "$JQ_HOOKS_ADD" >/dev/null 2>&1 \
            || warn "couldn't add the subagent events to settings.json – run 'dcc hooks install'"
    fi
    return 0
}

JQ_STRIP='def strip: map(.hooks |= map(select(.command != $cmd))) | map(select((.hooks | length) > 0));'
JQ_HOOKS_ADD="$JQ_STRIP"'
  .hooks = (.hooks // {})
  | reduce (["SessionStart",""], ["UserPromptSubmit",""], ["PreToolUse","*"], ["PostToolUse","*"],
            ["SubagentStart",""], ["SubagentStop",""],
            ["Notification",""], ["Stop",""], ["SessionEnd",""]) as $e (.;
      .hooks[$e[0]] = (((.hooks[$e[0]] // []) | strip)
        + [ (if $e[1] == "" then {} else {matcher: $e[1]} end)
            + {hooks: [{type: "command", command: $cmd, timeout: 5}]} ]))'
JQ_HOOKS_RM="$JQ_STRIP"'
  if .hooks then
    .hooks |= (with_entries(.value |= strip) | with_entries(select(.value | length > 0)))
    | if .hooks == {} then del(.hooks) else . end
  else . end'

# Apply jq program $1 to the home's settings.json. Runs inside the container
# (jq is there, the host may not have it); the previous file is kept as
# settings.json.dcc-bak, and a file jq can't parse is left untouched.
edit_settings() {
    ensure_up
    [ -f "$HOME_DIR/settings.json" ] && cp -p "$HOME_DIR/settings.json" "$HOME_DIR/settings.json.dcc-bak"
    compose exec -T --user dev -e DCC_HOOK_CMD="$HOOK_CMD" claude bash -c '
        f=/home/dev/.claude/settings.json
        [ -s "$f" ] || printf "{}\n" > "$f"
        jq --arg cmd "$DCC_HOOK_CMD" "$1" "$f" > "$f.dcc-tmp" && mv "$f.dcc-tmp" "$f"
        rc=$?; rm -f "$f.dcc-tmp"; exit $rc' _ "$1"
}

install_hooks() {
    write_hook_script
    edit_settings "$JQ_HOOKS_ADD" \
        || die "couldn't update $HOME_DIR/settings.json (is it valid JSON?) – left as it was"
    ok "session status hooks installed into $HOME_DIR/settings.json"
    printf '%s\n' "${c_dim}  Sessions started from now on show up in 'dcc ps' / 'dcc top' – restart the ones already open.${c_0}"
}

cmd_hooks() {
    load_instance
    case "${1:-status}" in
        install|on) install_hooks ;;
        rm|remove|off)
            hooks_installed "$HOME_DIR" || { ok "session status hooks aren't installed"; return 0; }
            edit_settings "$JQ_HOOKS_RM" \
                || die "couldn't update $HOME_DIR/settings.json (is it valid JSON?) – left as it was"
            rm -rf "${HOME_DIR:?}/.dcc/hooks" "${HOME_DIR:?}/.dcc-status"
            ok "session status hooks removed (previous settings.json kept as settings.json.dcc-bak)"
            ;;
        status)
            if hooks_installed "$HOME_DIR"; then ok "session status hooks installed"
            else warn "session status hooks not installed – 'dcc hooks install'"; fi
            ;;
        *) die "usage: dcc hooks install|rm|status" ;;
    esac
}

fmt_age() {
    local s="$1"
    case "$s" in ''|*[!0-9]*) s=0 ;; esac
    if   [ "$s" -lt 60 ];    then printf '%ds' "$s"
    elif [ "$s" -lt 3600 ];  then printf '%dm' $((s/60))
    elif [ "$s" -lt 86400 ]; then printf '%dh' $((s/3600))
    else printf '%dd' $((s/86400)); fi
}

# Text $1 cut/padded to exactly $2 characters ($3 = tail keeps the end
# instead, cut = only shorten, no padding)
fit() {
    local s="$1" w="$2"
    if [ "${#s}" -gt "$w" ]; then
        if [ "${3:-}" = tail ]; then s="$ELL${s:$((${#s}-w+1))}"; else s="${s:0:$((w-1))}$ELL"; fi
    fi
    [ "${3:-}" = cut ] && { printf '%s' "$s"; return; }
    printf '%s%*s' "$s" $((w-${#s})) ''
}

# Column widths need character counts, which bash only gives under a UTF-8
# locale – pick one if the user's isn't (macOS GUI apps often have none).
use_utf8_locale() {
    local loc
    case "$(locale charmap 2>/dev/null)" in UTF-8|utf8) ELL="…"; return 0 ;; esac
    loc="$(locale -a 2>/dev/null | grep -i -m1 -E '^(C|en_US)\.utf-?8$' || true)"
    [ -n "$loc" ] && { export LC_ALL="$loc"; ELL="…"; }
    return 0
}

state_cell() {
    local t c=""
    case "$1" in
        waiting) t="◆ waiting"; c="$c_y$c_b" ;;
        working) t="● working"; c="$c_g$c_b" ;;
        done)    t="✓ done";    c="$c_c" ;;
        idle)    t="○ idle";    c="$c_dim" ;;
        stale)   t="? gone";    c="$c_dim" ;;
        ended)   t="✗ ended";   c="$c_dim" ;;
        stopped) t="■ stopped"; c="$c_r" ;;
        nohooks) t="– no hooks"; c="$c_dim" ;;
        *)       t="○ no sessions"; c="$c_dim" ;;
    esac
    if [ "${2:-}" = nopad ]; then printf '%s%s%s' "$c" "$t" "$c_0"
    else printf '%s%s%s' "$c" "$(fit "$t" 13)" "$c_0"; fi
}

# 1234 → 1234, 41234 → 41k, 4123 → 4.1k, 1234567 → 1.2M
fmt_tok() {
    local n="$1"
    case "$n" in ''|*[!0-9]*) printf '–'; return ;; esac
    if   [ "$n" -lt 1000 ];    then printf '%d' "$n"
    elif [ "$n" -lt 10000 ];   then printf '%d.%dk' $((n/1000)) $((n%1000/100))
    elif [ "$n" -lt 1000000 ]; then printf '%dk' $((n/1000))
    else printf '%d.%dM' $((n/1000000)) $((n%1000000/100000)); fi
}

fmt_dur() {
    local s="$1"
    case "$s" in ''|*[!0-9]*) s=0 ;; esac
    if   [ "$s" -lt 60 ];   then printf '%ds' "$s"
    elif [ "$s" -lt 3600 ]; then printf '%dm%02ds' $((s/60)) $((s%60))
    else printf '%dh%02dm' $((s/3600)) $((s%3600/60)); fi
}

# Sum of tokens of a session's current flow (<record>.flow, column 4)
flow_tokens() {
    local f="$1.flow" id step models tok rest sum=0
    [ -f "$f" ] || { printf ''; return; }
    while IFS="$US" read -r id step models tok rest; do
        case "$tok" in ''|*[!0-9]*) continue ;; esac
        sum=$((sum+tok))
    done < "$f"
    [ "$sum" -gt 0 ] && printf '%s' "$sum"
    return 0
}

# flow pipeline progress → FLOW_TXT (coloured) and FLOW_LEN (visible width)
flow_cell() {
    local flow="$1" sstate="$2" tokens="${3:-}" step st name mark col t
    FLOW_TXT=""; FLOW_LEN=0
    [ -n "$flow" ] || return 0
    for step in recon spec implement review; do
        st=""
        case ",$flow," in *",$step="*) st="${flow#*"$step"=}"; st="${st%%,*}" ;; esac
        case "$step" in implement) name=impl ;; review) name=rev ;; *) name="$step" ;; esac
        case "$st" in
            done) mark="✓"; col="$c_g" ;;
            run)  if [ "$sstate" = working ]; then mark="▶"; col="$c_bc$c_b"; else mark="‖"; col="$c_y"; fi ;;
            ask)  mark="?"; col="$c_y$c_b" ;;
            *)    [ "$sstate" = working ] || continue; mark="·"; col="$c_dim" ;;
        esac
        [ -n "$FLOW_TXT" ] && { FLOW_TXT="$FLOW_TXT "; FLOW_LEN=$((FLOW_LEN+1)); }
        FLOW_TXT="$FLOW_TXT$col$name$mark$c_0"
        FLOW_LEN=$((FLOW_LEN + ${#name} + 1))
    done
    if [ -n "$tokens" ]; then
        t="$(fmt_tok "$tokens")"
        FLOW_TXT="$FLOW_TXT $c_m$t$c_0"; FLOW_LEN=$((FLOW_LEN + 1 + ${#t}))
    fi
}

# running/total subagents of a session
agents_cell() {
    local running="$1" total="$2" n=0 a IFS=,
    case "$total" in ''|*[!0-9]*) total=0 ;; esac
    for a in $running; do [ -n "$a" ] && n=$((n+1)); done
    if [ "$n" -gt 0 ]; then printf '%s%s%s' "$c_g$c_b" "$(fit "$n/$total" 6)" "$c_0"
    elif [ "$total" -gt 0 ]; then printf '%s' "$(fit "0/$total" 6)"
    else printf '%s%s%s' "$c_dim" "$(fit "–" 6)" "$c_0"; fi
}
count_running() { local n=0 a IFS=,; for a in $1; do [ -n "$a" ] && n=$((n+1)); done; printf '%d' "$n"; }

age_color() {
    if [ "$1" -lt 60 ]; then printf '%s' "$c_g"; elif [ "$1" -lt 3600 ]; then printf ''; else printf '%s' "$c_dim"; fi
}

notify_host() {
    local msg
    msg="$(printf '%s' "$1" | tr -cd 'A-Za-z0-9 ._/:-')"
    if command -v osascript >/dev/null 2>&1; then
        osascript -e "display notification \"$msg\" with title \"dcc\"" >/dev/null 2>&1 &
    elif command -v notify-send >/dev/null 2>&1; then
        notify-send dcc "$msg" >/dev/null 2>&1 &
    fi
    printf '\a'
}

# Reads a session record into R_* (validated); fails on anything malformed
read_record() {
    local v
    R_SID=""; R_CWD=""; R_STATE=""; R_STARTED=""; R_UPDATED=""; R_TOOL=""; R_DETAIL=""
    R_FLOW=""; R_RUNNING=""; R_TOTAL=""; R_FSTART=""
    [ -f "$1" ] || return 1
    IFS="$US" read -r v R_SID R_CWD R_STATE R_STARTED R_UPDATED R_TOOL R_DETAIL R_FLOW R_RUNNING R_TOTAL R_FSTART < "$1" \
        || [ -n "$R_SID" ] || return 1
    [ "$v" = 1 ] || return 1
    case "$R_SID" in ""|*[!A-Za-z0-9_-]*) return 1 ;; esac
    case "$R_UPDATED" in ''|*[!0-9]*) return 1 ;; esac
    case "$R_STARTED" in ''|*[!0-9]*) R_STARTED="$R_UPDATED" ;; esac
    case "$R_TOTAL" in ''|*[!0-9]*) R_TOTAL=0 ;; esac
    R_RUNNING="${R_RUNNING//[!A-Za-z0-9_,-]/}"
    R_FLOW="${R_FLOW//[!a-z=,-]/}"
    R_CWD="${R_CWD//[[:cntrl:]]/}"; R_TOOL="${R_TOOL//[[:cntrl:]]/}"; R_DETAIL="${R_DETAIL//[[:cntrl:]]/}"
    case "$R_CWD" in /workspace/?*) R_CWD="${R_CWD#/workspace/}" ;; esac
    return 0
}

# One frame of the overview on stdout. Leaves SNAP ("|sid:state|…") for the
# next frame to compare against, and NOTIFY_MSGS for sessions that went from
# working to waiting/done since PREV_SNAP.
render_overview() {
    local all="${1:-0}" footer="${2:-}" now cols home name up live list f k ci=0 icol
    local sid cwd state started updated tool detail flow running total prio last tok room
    local rows="" n_inst=0 n_up=0 n_sess=0 n_wait=0 n_agents=0 shown w_inst=8 w_dir=3 w_last
    now="$(date +%s)"
    cols="$(tput cols 2>/dev/null || echo 120)"; [ -t 1 ] || [ -n "$EOL" ] || cols=200
    up=" $(docker ps --format '{{.Names}}' 2>/dev/null | tr '\n' ' ') "
    SNAP="|"

    if [ -f "$REGISTRY" ]; then
        while IFS= read -r home; do
            [ -n "$home" ] && [ -f "$home/.dcc/instance" ] || continue
            name="$(sed -n 's/^PROJECT="\([A-Za-z0-9_.-]*\)"$/\1/p' "$home/.dcc/instance")"
            [ -n "$name" ] || continue
            ci=$((ci+1)); n_inst=$((n_inst+1)); [ "${#name}" -gt "$w_inst" ] && w_inst="${#name}"
            case "$up" in *" $name "*) n_up=$((n_up+1)); live="" ;; *) live=0 ;; esac
            if ! hooks_installed "$home"; then
                rows="$rows"$'\n'"8$US$now$US$ci$US$name$US$US$( [ "$live" = 0 ] && echo stopped || echo nohooks )"
                continue
            fi
            # live claude processes in the container: more records than that
            # that aren't ended belong to sessions that died without saying so
            if [ -z "$live" ]; then
                live="$(docker exec "$name" pgrep -c -x 'claude(\.exe)?' 2>/dev/null || true)"
                case "$live" in ''|*[!0-9]*) live="-" ;; esac
            fi
            list=""
            for f in "$home"/.dcc-status/*; do
                case "${f##*/}" in *.*) continue ;; esac      # .flow, .tmp, .lock
                read_record "$f" || continue
                if [ "$R_STATE" = ended ] && [ $((now-R_UPDATED)) -gt 604800 ]; then rm -f "$f" "$f.flow"; continue; fi
                tok="$(flow_tokens "$f")"
                list="$list$R_UPDATED$US$R_SID$US$R_CWD$US$R_STATE$US$R_STARTED$US$R_TOOL$US$R_DETAIL$US$R_FLOW$US$R_RUNNING$US$R_TOTAL$US$tok"$'\n'
            done
            k=0; shown=0
            while IFS="$US" read -r updated sid cwd state started tool detail flow running total tok; do
                [ -n "$sid" ] || continue
                if [ "$state" != ended ]; then
                    k=$((k+1))
                    [ "$live" != "-" ] && [ "$k" -gt "$live" ] && state=stale
                fi
                case "$state" in
                    waiting) prio=1 ;; working) prio=2 ;; done) prio=3 ;; idle) prio=4 ;;
                    stale) prio=6 ;; *) state=ended; prio=7 ;;
                esac
                [ "$prio" -ge 6 ] && running=""
                case "$PREV_SNAP" in
                    *"|$sid:working|"*)
                        case "$state" in
                            waiting) NOTIFY_MSGS="$NOTIFY_MSGS$name $cwd: needs your input"$'\n' ;;
                            done)    NOTIFY_MSGS="$NOTIFY_MSGS$name $cwd: finished"$'\n' ;;
                        esac ;;
                esac
                SNAP="$SNAP$sid:$state|"
                if [ "$prio" -le 4 ]; then
                    n_sess=$((n_sess+1)); [ "$state" = waiting ] && n_wait=$((n_wait+1))
                    n_agents=$((n_agents + $(count_running "$running")))
                fi
                [ "$prio" -ge 6 ] && [ "$all" != 1 ] && continue
                shown=$((shown+1))
                [ "${#cwd}" -gt "$w_dir" ] && w_dir="${#cwd}"
                rows="$rows"$'\n'"$prio$US$updated$US$ci$US$name$US$sid$US$state$US$started$US$cwd$US$tool$US$detail$US$flow$US$running$US$total$US$tok"
            done <<EOF2
$(printf '%s' "$list" | sort -t "$US" -k1,1nr)
EOF2
            [ "$shown" -gt 0 ] || rows="$rows"$'\n'"8$US$now$US$ci$US$name$US$US$( [ "$live" = 0 ] && echo stopped || echo none )"
        done < "$REGISTRY"
    fi

    printf '%s · %s%d%s instances (%s%d running%s) · %s%d%s sessions' "$c_bc${c_b}dcc$c_0" \
        "$c_b" "$n_inst" "$c_0" "$c_g" "$n_up" "$c_0" "$c_b" "$n_sess" "$c_0"
    [ "$n_wait" -gt 0 ] && printf ' · %s%d waiting%s' "$c_y$c_b" "$n_wait" "$c_0"
    [ "$n_agents" -gt 0 ] && printf ' · %s%d agent%s running%s' "$c_g$c_b" "$n_agents" "$( [ "$n_agents" -gt 1 ] && echo s)" "$c_0"
    printf '%s\n%s\n' "${c_dim} · $(date +%H:%M:%S)${c_0}$EOL" "$EOL"
    [ "$n_inst" -gt 0 ] || { printf '%s\n' "no instances – 'dcc create'$EOL"; return 0; }

    # fixed columns take 42 characters incl. separators; INSTANCE and DIR
    # get what they need up to a cap, the rest goes to FLOW / LAST
    if [ "$cols" -lt 120 ]; then
        [ "$w_inst" -gt 18 ] && w_inst=18; [ "$w_dir" -gt 20 ] && w_dir=20
    else
        [ "$w_inst" -gt 24 ] && w_inst=24; [ "$w_dir" -gt 32 ] && w_dir=32
    fi
    w_last=$((cols - w_inst - w_dir - 43))
    printf '%s%s %s %s %s %s %s %s %s%s\n' "$c_b" "$(fit INSTANCE "$w_inst")" "$(fit SESSION 8)" \
        "$(fit STATE 13)" "$(fit AGE 4)" "$(fit UP 4)" "$(fit AGENTS 6)" "$(fit DIR "$w_dir")" "FLOW / LAST" "$c_0$EOL"
    while IFS="$US" read -r prio updated ci name sid state started cwd tool detail flow running total tok; do
        [ -n "$name" ] || continue
        icol="${INST_COLORS[$(( (ci-1) % ${#INST_COLORS[@]} ))]}"
        if [ -z "$sid" ]; then
            printf '%s %s %s%s\n' "$icol$(fit "$name" "$w_inst")$c_0" "$(fit "" 8)" "$(state_cell "$state")" "$EOL"
            continue
        fi
        case "$state" in
            working) last="${tool:-thinking}${detail:+ · $detail}" ;;
            *)       last="$detail" ;;
        esac
        flow_cell "$flow" "$state" "$tok"
        room=$((w_last - FLOW_LEN - (FLOW_LEN > 0 ? 2 : 0)))
        [ "$room" -lt 8 ] && room=8
        printf '%s %s %s %s %s %s %s %s%s%s\n' \
            "$icol$(fit "$name" "$w_inst")$c_0" "$c_dim$(fit "${sid:0:8}" 8)$c_0" \
            "$(state_cell "$state")" \
            "$(age_color $((now-updated)))$(fit "$(fmt_age $((now-updated)))" 4)$c_0" \
            "$c_dim$(fit "$(fmt_age $((now-started)))" 4)$c_0" \
            "$(agents_cell "$running" "$total")" \
            "$c_bl$(fit "$cwd" "$w_dir" tail)$c_0" \
            "$FLOW_TXT$( [ "$FLOW_LEN" -gt 0 ] && printf '  ' )" \
            "$( [ "$state" = waiting ] && printf '%s' "$c_y" || printf '%s' "$c_dim" )$(fit "$last" "$room" cut)$c_0" "$EOL"
    done <<EOF2
$(printf '%s\n' "$rows" | sort -t "$US" -k1,1n -k2,2nr)
EOF2
    [ -n "$footer" ] && printf '\n%s\n' "$c_dim$footer$c_0$EOL"
    return 0
}

# dcc ps <session> – one session in detail: its flow, step by step
render_session() {
    local prefix="$1" home name f found="" fname="" fci=0 ci=0 n=0 now step steps="" st mark col rest
    local id s models tok out first last run m t_tok t_out t_time t_run t_models total_tok=0 total_out=0 total_time=0
    case "$prefix" in ''|*[!A-Za-z0-9-]*) die "usage: dcc ps [-a] | dcc ps <session-id>" ;; esac
    [ -f "$REGISTRY" ] || die "no instance"
    while IFS= read -r home; do
        [ -n "$home" ] && [ -f "$home/.dcc/instance" ] || continue
        name="$(sed -n 's/^PROJECT="\([A-Za-z0-9_.-]*\)"$/\1/p' "$home/.dcc/instance")"
        [ -n "$name" ] || continue
        ci=$((ci+1))
        for f in "$home"/.dcc-status/"$prefix"*; do
            case "${f##*/}" in *.*) continue ;; esac
            [ -f "$f" ] || continue
            n=$((n+1)); found="$f"; fname="$name"; fci="$ci"
        done
    done < "$REGISTRY"
    [ "$n" -gt 0 ] || die "no session starting with '$prefix' – see 'dcc ps -a'"
    [ "$n" -eq 1 ] || die "'$prefix' matches $n sessions – use more of the id"
    read_record "$found" || die "can't read the record of session '$prefix'"
    now="$(date +%s)"

    printf '%s · %s · %s · %s · %s%s\n' "$c_b${R_SID:0:8}$c_0" \
        "${INST_COLORS[$(( (fci-1) % ${#INST_COLORS[@]} ))]}$fname$c_0" \
        "$c_bl$R_CWD$c_0" "$(state_cell "$R_STATE" nopad)" \
        "$c_dim$(fmt_age $((now-R_STARTED))) up$c_0" "${R_DETAIL:+ · $R_DETAIL}"
    printf 'agents %s running%s / %s total\n\n' "$c_g$c_b$(count_running "$R_RUNNING")" "$c_0" "$R_TOTAL"
    if [ -z "$R_FLOW" ]; then
        printf '%s\n' "${c_dim}no /flow run in this session${c_0}"
        return 0
    fi

    # steps in pipeline order, then anything else the subagents were called
    steps="recon spec implement review"
    if [ -f "$found.flow" ]; then
        while IFS="$US" read -r id s rest; do
            s="${s//[!a-z-]/}"
            case " $steps " in *" $s "*) ;; *) [ -n "$s" ] && steps="$steps $s" ;; esac
        done < "$found.flow"
    fi
    printf '  %s%s %s %s %s %s %s%s\n' "$c_b" "$(fit STEP 11)" "$(fit MODEL 18)" "$(fit STATE 6)" \
        "$(fit TIME 8)" "$(fit TOKENS 8)" "OUTPUT" "$c_0"
    for step in $steps; do
        st=""; case ",$R_FLOW," in *",$step="*) st="${R_FLOW#*"$step"=}"; st="${st%%,*}" ;; esac
        t_tok=0; t_out=0; t_time=0; t_run=0; t_models=""
        if [ -f "$found.flow" ]; then
            while IFS="$US" read -r id s models tok out first last run; do
                [ "$s" = "$step" ] || continue
                case "$tok$out$first$last" in *[!0-9]*) continue ;; esac
                t_tok=$((t_tok+tok)); t_out=$((t_out+out))
                [ "$run" = 1 ] && { t_run=1; last="$now"; }
                [ "$last" -ge "$first" ] && t_time=$((t_time + last - first))
                models="${models//[!a-z0-9.+-]/}"
                local IFS_OLD="$IFS"; IFS=+
                for m in $models; do case "+$t_models+" in *"+$m+"*) ;; *) t_models="${t_models:+$t_models+}$m" ;; esac; done
                IFS="$IFS_OLD"
            done < "$found.flow"
        fi
        [ -z "$st" ] && [ "$t_tok" = 0 ] && [ "$R_STATE" != working ] && continue
        case "$st" in
            done) mark="✓"; col="$c_g" ;;
            run)  if [ "$R_STATE" = working ] || [ "$t_run" = 1 ]; then mark="▶"; col="$c_bc$c_b"; else mark="‖"; col="$c_y"; fi ;;
            ask)  mark="?"; col="$c_y$c_b" ;;
            *)    if [ "$t_tok" -gt 0 ]; then mark="✓"; col="$c_g"; else mark="·"; col="$c_dim"; fi ;;
        esac
        total_tok=$((total_tok+t_tok)); total_out=$((total_out+t_out)); total_time=$((total_time+t_time))
        printf '  %s %s %s %s %s %s\n' "$col$(fit "$step" 11)$c_0" "$c_c$(fit "${t_models:-–}" 18)$c_0" \
            "$col$(fit "$mark" 6)$c_0" \
            "$(fit "$( [ "$t_time" -gt 0 ] && fmt_dur "$t_time" || printf '–')$( [ "$t_run" = 1 ] && printf '…')" 8)" \
            "$c_m$(fit "$( [ "$t_tok" -gt 0 ] && fmt_tok "$t_tok" || printf '–')" 8)$c_0" \
            "$( [ "$t_out" -gt 0 ] && fmt_tok "$t_out" || printf '–')"
    done
    printf '  %s %s %s %s %s %s%s\n' "$c_b$(fit total 11)" "$(fit "" 18)" "$(fit "" 6)" \
        "$(fit "$( [ "$total_time" -gt 0 ] && fmt_dur "$total_time" || printf '–')" 8)" \
        "$c_m$(fit "$( [ "$total_tok" -gt 0 ] && fmt_tok "$total_tok" || printf '–')" 8)$c_0$c_b" \
        "$( [ "$total_out" -gt 0 ] && fmt_tok "$total_out" || printf '–')" "$c_0"
    return 0
}

EOL=""; PREV_SNAP=""; SNAP=""; NOTIFY_MSGS=""; DCC_TOP_TMP=""; ELL="~"

cmd_ps() {
    local all=0
    use_utf8_locale
    case "${1:-}" in
        -a|--all) all=1 ;;
        "") ;;
        -*) die "usage: dcc ps [-a] | dcc ps <session-id>" ;;
        *) render_session "$1"; return ;;
    esac
    render_overview "$all"
}

# ---------------------------------------------------------------------------
# dcc new: pick an instance and one of its mounted folders, start a session
# ---------------------------------------------------------------------------

# Shell single-quoting / AppleScript string literal for arbitrary text
sq()     { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }
as_str() { local t="${1//\\/\\\\}"; printf '"%s"' "${t//\"/\\\"}"; }

# pick <title> <item>... → PICK (1-based); fails when cancelled. fzf when
# it's installed, a numbered menu otherwise (DCC_PICKER=menu forces that).
pick() {
    local title="$1" n i ans line it
    shift; n=$#; PICK=""
    [ "$n" -gt 0 ] || return 1
    if [ "${DCC_PICKER:-}" != menu ] && command -v fzf >/dev/null 2>&1 && [ -t 0 ]; then
        line="$(i=0; for it in "$@"; do i=$((i+1)); printf '%d\t%s\n' "$i" "$it"; done \
            | fzf --prompt="$title > " --delimiter="$(printf '\t')" --with-nth=2.. \
                  --height=60% --reverse --no-multi)" || return 1
        PICK="${line%%"$(printf '\t')"*}"
        return 0
    fi
    printf '\n%s\n' "$c_b$title$c_0" >&2
    i=0
    for it in "$@"; do i=$((i+1)); printf '  %2d) %s\n' "$i" "$it" >&2; done
    read -r -p "Number (Enter = cancel): " ans || return 1
    case "$ans" in ''|*[!0-9]*) return 1 ;; esac
    [ "$ans" -ge 1 ] && [ "$ans" -le "$n" ] || return 1
    PICK="$ans"
}

# Interactive choice → T_HOME (instance home) and T_DIR (host folder)
choose_target() {
    local home up st host cont mode sub
    local homes=() labels=() dirs=() dlabels=()
    T_HOME=""; T_DIR=""
    [ -f "$REGISTRY" ] || { warn "no instance yet – 'dcc create'"; return 1; }
    up=" $(docker ps --format '{{.Names}}' 2>/dev/null | tr '\n' ' ') "
    while IFS= read -r home; do
        [ -n "$home" ] && parse_instance "$home/.dcc/instance" || continue
        case "$up" in *" $I_PROJECT "*) st="running" ;; *) st="stopped" ;; esac
        homes+=("$home"); labels+=("$(fit "$I_PROJECT" 24) $(fit "$st" 8) $home")
    done < "$REGISTRY"
    [ "${#homes[@]}" -gt 0 ] || { warn "no usable instance in $REGISTRY"; return 1; }
    if [ "${#homes[@]}" -eq 1 ]; then
        T_HOME="${homes[0]}"
    else
        pick "Instance" "${labels[@]}" || return 1
        T_HOME="${homes[$((PICK-1))]}"
    fi

    check_mounts "$T_HOME/.dcc/mounts" || { warn "refusing to use mounts: $I_ERROR"; return 1; }
    while IFS='|' read -r host cont mode; do
        [ -n "$host" ] && [ -d "$host" ] || continue
        case "$cont/" in /home/dev/*) continue ;; esac     # caches like ~/.m2, not projects
        dirs+=("$host"); dlabels+=("$cont$( [ "$mode" = ro ] && echo ' (ro)')")
        for sub in "$host"/*/; do
            [ -d "$sub" ] || continue
            sub="${sub%/}"
            case "$sub" in *[[:cntrl:]]*) continue ;; esac
            dirs+=("$sub"); dlabels+=("$cont/${sub##*/}")
        done
    done < "$T_HOME/.dcc/mounts"
    [ "${#dirs[@]}" -gt 0 ] || { warn "$T_HOME has no project folders mounted – 'dcc mount add'"; return 1; }
    pick "Folder" "${dlabels[@]}" || return 1
    T_DIR="${dirs[$((PICK-1))]}"
}

# Open "dcc" for T_HOME in T_DIR in a new tab/window of the terminal dcc
# itself runs in. Fails when that terminal isn't one it knows how to drive.
open_in_new_tab() {
    local cmd shell="${SHELL:-/bin/bash}"
    cmd="cd $(sq "$T_DIR") && DCC_HOME=$(sq "$T_HOME") $(sq "$DCC_SELF")"
    if [ -n "${TMUX:-}" ] && command -v tmux >/dev/null 2>&1; then
        tmux new-window -c "$T_DIR" "$cmd" && return 0
    fi
    case "${TERM_PROGRAM:-}" in
        iTerm.app)
            osascript >/dev/null 2>&1 <<OSA && return 0
tell application "iTerm2"
    tell current window
        create tab with default profile
        tell current session to write text $(as_str "$cmd")
    end tell
end tell
OSA
            ;;
        Apple_Terminal)
            osascript -e "tell application \"Terminal\" to do script $(as_str "$cmd")" >/dev/null 2>&1 && return 0 ;;
        WezTerm)
            wezterm cli spawn --cwd "$T_DIR" -- "$shell" -lc "$cmd" >/dev/null 2>&1 && return 0 ;;
        ghostty)
            if [ "$(uname)" = Darwin ]; then
                open -na Ghostty.app --args --working-directory="$T_DIR" -e "$shell" -lc "$cmd" >/dev/null 2>&1 && return 0
            else
                ( ghostty --working-directory="$T_DIR" -e "$shell" -lc "$cmd" >/dev/null 2>&1 & ) && return 0
            fi ;;
    esac
    if [ -n "${KITTY_WINDOW_ID:-}" ] && command -v kitty >/dev/null 2>&1; then
        kitty @ launch --type=tab --cwd "$T_DIR" "$shell" -lc "$cmd" >/dev/null 2>&1 && return 0
    fi
    return 1
}

run_here() { ( cd "$T_DIR" && DCC_HOME="$T_HOME" "$DCC_SELF" ); }

cmd_new() {
    local tab=0
    case "${1:-}" in -t|--tab) tab=1 ;; "") ;; *) die "usage: dcc new [--tab]" ;; esac
    use_utf8_locale
    choose_target || { info "cancelled"; return 0; }
    if [ "$tab" = 1 ]; then
        open_in_new_tab && { ok "session opened in a new tab: $T_DIR"; return 0; }
        warn "can't open a tab in this terminal (${TERM_PROGRAM:-unknown}) – starting here"
    fi
    run_here
}

cmd_top() {
    local all=0 interval=2 notify=0 key line
    while [ $# -gt 0 ]; do
        case "$1" in
            -a|--all) all=1 ;;
            -n) shift; interval="${1:-}" ;;
            --notify) notify=1 ;;
            *) die "usage: dcc top [-a] [-n seconds] [--notify]" ;;
        esac
        shift
    done
    case "$interval" in ''|*[!0-9]*|0) die "the interval has to be a whole number of seconds" ;; esac
    [ -t 1 ] || die "dcc top needs a terminal – use 'dcc ps' instead"
    use_utf8_locale
    DCC_TOP_TMP="$(mktemp)"
    EOL="$(tput el 2>/dev/null || true)"
    tput smcup 2>/dev/null || true; tput civis 2>/dev/null || true
    trap 'tput cnorm 2>/dev/null; tput rmcup 2>/dev/null; rm -f "$DCC_TOP_TMP"' EXIT
    trap 'exit 0' INT TERM
    while :; do
        NOTIFY_MSGS=""
        render_overview "$all" "q quit · n new session · a $( [ "$all" = 1 ] && echo hide || echo show ) ended · every ${interval}s$( [ "$notify" = 1 ] && echo ' · notifications on' )" > "$DCC_TOP_TMP"
        tput cup 0 0 2>/dev/null || true
        cat "$DCC_TOP_TMP"
        tput ed 2>/dev/null || true
        if [ "$notify" = 1 ] && [ -n "$NOTIFY_MSGS" ]; then
            while IFS= read -r line; do [ -n "$line" ] && notify_host "$line"; done <<EOF2
$NOTIFY_MSGS
EOF2
        fi
        PREV_SNAP="$SNAP"
        if read -rsn1 -t "$interval" key; then
            case "$key" in
                q|Q) break ;;
                a|A) all=$((1-all)) ;;
                n|N) tput cnorm 2>/dev/null || true; tput clear 2>/dev/null || true
                     if choose_target && ! open_in_new_tab; then
                         # unknown terminal: run it right here, back to top afterwards
                         tput rmcup 2>/dev/null || true
                         run_here || true
                         tput smcup 2>/dev/null || true
                     fi
                     tput civis 2>/dev/null || true; tput clear 2>/dev/null || true ;;
            esac
        fi
    done
}

usage() {
    cat <<EOF
${c_b}dcc${c_0} – Claude Code in an isolated Docker container (v$DCC_VERSION)

  ${c_b}dcc create${c_0} [dir]     first-time setup: turns this directory into a
                       home for Claude Code and interactively adds mounts
  ${c_b}dcc${c_0}                  runs Claude Code (in the matching directory)
  ${c_b}dcc login${c_0}            log in to your account
  ${c_b}dcc shell${c_0}            bash inside the container
  ${c_b}dcc exec${c_0} -- <cmd>    run a one-off command

  ${c_b}dcc mount${c_0} list|add|rm      manage mounted directories
  ${c_b}dcc port${c_0} list|add|rm       forward an extra host<->container port
  ${c_b}dcc up${c_0} | down | restart | status | logs
  ${c_b}dcc doctor${c_0}           diagnose the instance
  ${c_b}dcc homes${c_0}            list all instances
  ${c_b}dcc ps${c_0} [-a]          sessions of all instances and what they're doing
  ${c_b}dcc top${c_0} [--notify]   the same, refreshed live (q quits, n new session)
  ${c_b}dcc new${c_0} [--tab]         pick an instance and folder, start a session there
  ${c_b}dcc hooks${c_0} install|rm|status   session status hooks for ps/top

  ${c_b}dcc build${c_0}            (re)build the base image
  ${c_b}dcc update${c_0}           base image from scratch + restart
  ${c_b}dcc claude-update${c_0}    update Claude Code (rebuilds its layer or re-bakes the snapshot)
  ${c_b}dcc snapshot${c_0} [tag]   bake the current container state into an image
  ${c_b}dcc reset${c_0}            back to the clean base image
  ${c_b}dcc destroy${c_0}          remove the container and cache (home stays)
EOF
}

# ---------------------------------------------------------------------------

case "${1:-run}" in
    create)   shift; cmd_create "$@" ;;
    mount)    shift; cmd_mount "$@" ;;
    port)     shift; cmd_port "$@" ;;
    snapshot) shift; cmd_snapshot "$@" ;;
    reset)    shift; cmd_reset ;;
    claude-update) shift; need_docker; cmd_claude_update ;;
    doctor)   shift; cmd_doctor ;;
    homes)    shift; cmd_homes ;;
    hooks)    shift; cmd_hooks "$@" ;;
    ps)       shift; cmd_ps "$@" ;;
    top)      shift; cmd_top "$@" ;;
    new)      shift; cmd_new "$@" ;;
    destroy)  shift; cmd_destroy ;;

    build)    shift; need_docker; build_base "$@" ;;
    update)   shift; need_docker; build_base --no-cache --pull
              load_instance; compose up -d --force-recreate ;;

    up)       load_instance; ensure_up; ok "running" ;;
    down)     load_instance; compose down ;;
    restart)  load_instance; compose down; ensure_up ;;
    status)   load_instance; compose ps ;;
    logs)     shift; load_instance; compose logs "$@" ;;

    login)    load_instance; enter "$(container_path)" claude ;;
    shell)    load_instance; enter "$(container_path)" bash ;;
    exec)     shift; [ "${1:-}" = "--" ] && shift
              [ $# -gt 0 ] || die "missing command"
              load_instance; enter "$(container_path)" "$@" ;;

    -v|--version) printf 'dcc %s\n' "$DCC_VERSION" ;;
    -h|--help|help) usage ;;
    run)      load_instance; enter "$(container_path)" claude --dangerously-skip-permissions ;;
    -*)       die "unknown flag: $1 (dcc --help)" ;;
    *)        # dcc <mount subdirectory> – quick jump into a project
              load_instance
              target="$(abspath "$1")" || die "unknown command or directory: $1"
              enter "$(container_path "$target")" claude --dangerously-skip-permissions ;;
esac
